<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View User</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: #f4f4f9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            width: 50%;
            max-width: 700px;
            background: #ffffff;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: 0.3s;
        }

        .container:hover {
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
        }

        h2 {
            text-align: center;
            font-size: 24px;
            color: #333;
            margin-bottom: 15px;
            border-bottom: 2px solid #007bff;
            padding-bottom: 10px;
        }

        p {
            font-size: 16px;
            color: #555;
            margin-bottom: 10px;
            padding: 8px 12px;
            border-left: 3px solid #007bff;
            background: #f9f9ff;
            border-radius: 5px;
        }

        p strong {
            color: #007bff;
            font-weight: 600;
        }

        .back-btn {
            display: block;
            width: 120px;
            margin: 20px auto;
            padding: 10px;
            background: #007bff;
            color: white;
            text-align: center;
            text-decoration: none;
            font-size: 16px;
            font-weight: bold;
            border-radius: 5px;
            transition: 0.3s;
        }

        .back-btn:hover {
            background: #0056b3;
            transform: translateY(-2px);
        }

        @media (max-width: 768px) {
            .container {
                width: 90%;
                padding: 20px;
            }

            p {
                font-size: 14px;
            }

            .back-btn {
                width: 100px;
                font-size: 14px;
            }
        }
    </style>
</head>

<body>

    <%- include(currentUser.UserType='admin' ? '../partials/sidenav-admin.ejs' : '../partials/sidenav-user' ) %>
        <div class="container">
            <h2>User Details</h2>
            <p><strong>User ID:</strong>
                <%= user.id %>
            </p>
            <p><strong>Full Name:</strong>
                <%= user.username %>
            </p>
            <p><strong>Email:</strong>
                <%= user.email %>
            </p>
            <p><strong>Contact Number:</strong>
                <%= user.ContactNumber %>
            </p>
            <p><strong>Organisation:</strong>
                <%= user.organisation %>
            </p>
            <p><strong>UserType:</strong>
                <%= user.UserTypeName %>
            </p>

            <p><strong>Request Status:</strong>
                <%= user.RequestStatusName %>
            </p>
            <p><strong>Reason for Request:</strong>
                <%= user.reason_for_req %>
            </p>
            <p><strong>Comments:</strong>
                <%= user.comments %>
            </p>
            <p><strong>Created Date:</strong>
                <%= new Date(user.date_of_req).toLocaleString('en-US', { year: 'numeric' , month: 'long' ,
                    day: 'numeric' , hour: '2-digit' , minute: '2-digit' , hour12: true }) %>
            </p>
            <p><strong>Created By:</strong>
                <%= user.CreatedByName || 'Unknown' %>
            </p>
            <p><strong>Updated By:</strong>
                <%= user.UpdatedByName || 'Not yet updated' %>
            </p>
            <p><strong>Last Updated:</strong>
                <%= user.updated_date ? new Date(user.updated_date).toLocaleString('en-US', { year: 'numeric' ,
                    month: 'long' , day: 'numeric' , hour: '2-digit' , minute: '2-digit' , hour12: true })
                    : 'Not Updated Yet' %>
            </p>

            <a href="<%= isAdminRequestor ? '/admin/UserRequest' : '/imagingUser' %>" class="back-btn">Back</a>

        </div>

</body>

</html>