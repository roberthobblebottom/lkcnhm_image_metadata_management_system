<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>My Imaging Requests</title>
  <link rel="stylesheet" href="/css/user.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      margin: 30px;
      background: #f5f5f5;
      
    }

    .main_con {
      margin-left: 600px;
      
    }

    .btn {
      display: inline-block;
      background: #007bff;
      color: white;
      padding: 10px 16px;
      border: none;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      float: right;
      margin-top: 50px;
      margin-left: 400px;
    }

    h2 {
      padding-left: 20px;
      text-align: center;
      margin: 20px 0;
      color: #333;
    }

    table {
      width: 200%;
      border-collapse: collapse;
      background: white;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      border-radius: 8px;
      overflow: hidden;
      margin-top: 30px;
    }

    th, td {
      padding: 12px 15px;
      border-bottom: 1px solid #eee;
      text-align: left;
    }

    th {
      background-color: #007bff;
      color: white;
      font-weight: 700;
    }

    tr:hover {
      background-color: #f1f1f1;
    }

    .status-approved { color: green; font-weight: bold; }
    .status-rejected { color: red; font-weight: bold; }

    .view-btn {
      background: #17a2b8;
      color: white;
      padding: 6px 12px;
      border-radius: 6px;
      text-decoration: none;
      font-size: 14px;
    }

    .view-btn:hover {
      background: #138496;
    }

    .no-data {
      text-align: center;
      color: gray;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="main_con">
    <h2 style="margin-top: 50px;">MY IMAGING REQUESTS</h2>
    <%- include('partials/sidenav_user') %>

    <% if (showPendingAlert) { %>
      <button class="btn" disabled style="opacity: 0.6;" title="Wait for admin approval">➕ Add Imaging Request (Locked)</button>
    <% } else { %>
      <a href="/imaging-request-user"><button class="btn"> Add Imaging Request</button></a>
    <% } %>
<br>
  

    <% if (imagingRequests.length === 0) { %>
      <p class="no-data">No imaging requests found.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Photographer</th>
            <th>Date of Request</th>
            <th>Start</th>
            <th>End</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% imagingRequests.forEach(req => { %>
            <tr>
              <td><%= req.ImagingRequestID %></td>
              <td><%= req.photographer_name %></td>
              <td><%= req.DateofRequest?.toISOString().slice(0, 10) %></td>
              <td><%= req.ImagingStartDate?.toISOString().slice(0, 10) %></td>
              <td><%= req.ImagingEndDate?.toISOString().slice(0, 10) %></td>
              <td class="<%= req.RequestStatusName === 'approved' ? 'status-approved' : req.RequestStatusName === 'rejected' ? 'status-rejected' : '' %>">
                <%= req.RequestStatusName || '-' %>
              </td>
              <td>
                <a href="/user/view-imaging-request/<%= req.ImagingRequestID %>" class="view-btn">View</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <script>
    <% if (showPendingAlert) { %>
      Swal.fire({
        icon: 'info',
        title: 'Hold On!',
        text: 'Your user access request is still pending approval. Imaging Request cannot be added until approved.',
        confirmButtonColor: '#007bff'
      });
    <% } %>
  </script>
</body>
</html>
