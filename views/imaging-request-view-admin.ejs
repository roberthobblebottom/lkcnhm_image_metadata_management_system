<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Imaging Requests</title>
  <link rel="stylesheet" href="/css/admin.css" />
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      margin: 30px;
      background: #f5f5f5;
    }

    .main_con {
      margin-left: 350px; 
    }

    .btn {
      display: inline-block;
      background: #007bff;
      color: white;
      padding: 10px 16px;
      border: none;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      float: right;
      margin-top: 50px;
    }

    h2 {
      text-align: center;
      margin: 20px 0;
      color: #333;
    }


 
    .status-approved { color: green; font-weight: bold; }
    .status-rejected { color: red; font-weight: bold; }

    .view-btn, .edit-btn, .delete-btn {
      padding: 6px 12px;
      border-radius: 6px;
      text-decoration: none;
      font-size: 14px;
      color: white;
    }

    .view-btn {
      background: #17a2b8;
    }

    .view-btn:hover {
      background: #138496;
    }

    .edit-btn {
      background: #FFA500;
    }

    .edit-btn:hover {
      background: #e68a00;
    }

    .delete-btn {
      background: #dc3545;
    }

    .delete-btn:hover {
      background: #c82333;
    }

    .no-data {
      text-align: center;
      color: gray;
      margin-top: 20px;
    }
    
  </style>
</head>
<body>
  <div class="main_con">
    <%- include('partials/sidenav') %>
 
   <center> <h2 style="margin-left: 35%;margin-top: 40px;">Imaging Request Management</h2></center>
    <div style="text-align: right; margin-right: -260px;">
      <a href="/imaging-request-admin"><button class="btn">Add Imaging Request</button></a>
    </div>
    <% if (imagingRequests.length === 0) { %>
      <p class="no-data">No imaging requests found.</p>
    <% } else { %>
      <table style="width: 130%; " >
        <thead>
          <tr>
            <th>ID</th>
            <th>Requestor</th>
            <th>Photographer</th>
            <th>Date of Request</th>
            <th>Start</th>
            <th>End</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% imagingRequests.forEach(request => { %>
            <tr>
              <td><%= request.ImagingRequestID || 'Not specified' %></td>
              <td><%= request.requestor_name || 'Not specified' %></td>
              <td><%= request.photographer_name || 'Not specified' %></td>
              <td><%= request.DateofRequest?.toISOString().slice(0, 10) %></td>
              <td><%= request.ImagingStartDate?.toISOString().slice(0, 10) %></td>
              <td><%= request.ImagingEndDate?.toISOString().slice(0, 10) %></td>
              <td class="<%= request.RequestStatus === 'approved' ? 'status-approved' : request.RequestStatus === 'rejected' ? 'status-rejected' : '-' %>">
                <%= request.RequestStatus || 'pending' %>
              </td>
              
              <td>
                <a href="/admin/view-imaging-request/<%= request.ImagingRequestID %>" class="view-btn">View</a>
                <a href="/admin/edit-imaging-request/<%= request.ImagingRequestID %>" class="edit-btn">Edit</a>
                <form action="/admin/delete-imaging-request/<%= request.ImagingRequestID %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this request?');" style="display:inline;">
                  <button type="submit" class="delete-btn">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <script>
    // SweetAlert setup for delete confirmation
    document.querySelectorAll('.delete-btn').forEach(button => {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        Swal.fire({
          title: 'Are you sure?',
          text: 'You will not be able to undo this action!',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#d33',
          confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
          if (result.isConfirmed) {
            this.closest('form').submit();
          }
        });
      });
    });
  </script>
</body>
</html>
