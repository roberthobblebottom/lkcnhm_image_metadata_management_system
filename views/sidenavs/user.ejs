<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
  <div class="sidebar">
    <div class="logo">
      <img src="/images/Group-1.svg" alt="LKCNHM Logo" />
    </div>
    <ul class="nav-links">
      <li>
        <div id="fullName" class="loginDetails"></div>
        <div id="emailSidebar" class="loginDetails"></div>
        <div id="userType" class="loginDetails"></div>
        <div id="userID" class="loginDetails"></div>
      </li>
      <li>
        <a href="/user/login-landing-page">
          <i class="fas fa-globe"></i><span>Home page</span>
        </a>
      </li>
      <li>
        <a href="/settings/profile">
          <i class="fa-solid fa-user-pen"></i><span>View/Edit Profile</span>
        </a>
      </li>
      <li id="projectManagement">
        <a href="/project/view-all">
          <i class="fas fa-file-medical"></i>
          <span>Project Management</span>
        </a>
      </li>
      <li>
        <a href="/media/view-all">
          <i class="fas fa-image"></i><span>Image Metadata Management</span>
        </a>
      </li>

      <li id="download-all-projects-data">
        <!-- <form id='download-all-projects-data' method="post" action="/download-all-projects-data"></form> -->
        <!-- <a onclick="document.getElementById('download-all-projects-data').submit()"> -->
        <a onclick="downloadAllProjectsData()" >

          <i class="fas fa-arrow-down"></i><span>Download All Your Projects' Data</span>
        </a>
      </li>



      <li>
        <a href="/settings/change-password">
          <i class="fas fa-key"></i><span>Change Password</span>
        </a>
      </li>
      <li>
        <a href="/auth/logout">
          <i class="fas fa-sign-out-alt"></i><span>Logout</span>
        </a>
      </li>
    </ul>

  </div>
  <script>
    var fullNameGlobal = ""
    document.addEventListener("DOMContentLoaded", function () {
      fetch("/auth/current-user", { cache: 'reload', method: 'GET' })
        .then(res => res.json())
        .then(data => {
          const email = data.Email;
          const fullName = data.FullName;
          const userType = data.UserType
          const userID = data.UserID;
          document.getElementById("fullName").textContent = `Logged in as: ${fullName}`
          document.getElementById("emailSidebar").textContent = `Email: ${email}`;
          document.getElementById("userType").textContent = `Role: ${userType}`;
          document.getElementById("userID").textContent = `UserID: ${userID}`;
          // document.getElementById("projectManagement").hidden =
          //   userType == 'photographerOnly' ? true : false
          document.getElementById("download-all-projects-data").hidden =
            userType == 'projectOwner'
              ? false
              : true
          fullNameGlobal = fullName
        })

    });

    async function downloadAllProjectsData() {
      await Swal.fire(
        {
          title: "Confirmation?",
          text: 'Are you sure you want to download the data',
          icon: "question",
            confirmButtonText: 'confirm',
        }

      ).then(async (confirm) => {
        if (!confirm)
          return
        try {
          const response = await fetch('/download-all-projects-data',
            {
              method: 'GET',
            }
          )
          const result = await response.json();
          // pass your byte response to this constructor
          var bytes = new Uint8Array(result.buffer.data);
          // change resultByte to bytes
          var blob = new Blob([bytes], { type: "application/zip" });
          var link = document.createElement('a');
          link.href = window.URL.createObjectURL(blob);
          link.download = "allProjectsDataFor" + fullNameGlobal + ".zip";
          link.click();
        } catch (error) {
          Swal.fire({
            title: 'Error!',
            text: 'An unexpected error occurred' + error,
            icon: 'error',
            confirmButtonColor: '#00bbff'
          });
        }
      })

    }
  </script>
</body>

</html>