<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
</head>

<body>
  <div class="sidebar">
    <div class="logo">
      <img src="/images/Group-1.svg" alt="LKCNHM Logo"  />
    </div>
    <ul class="nav-links">
      <li>
        <div id="fullName"class="loginDetails"></div>
        <div id="email"class="loginDetails"></div>
        <div id="userType"class="loginDetails"></div>
        <div id="userID"class="loginDetails"></div>
      </li>
      <li><a href="/user/login-landing-page"><i class="fas fa-globe"></i><span>Help page</span></a></li>
      <li><a href="/settings/profile"><i class="fas fa-key"></i><span>Profile</span></a></li>
      <li id="projectManagement"><a href="/project/view-all"><i class="fas fa-file-medical"></i><span>Project
            Management</span></a></li>
      <li><a href="/media/view-all"><i class="fas fa-image"></i><span>Image Metadata Management</span></a></li>
      <li><a href="/settings/change-password"><i class="fas fa-key"></i><span>Change Password</span></a></li>

      <li><a href="/auth/logout"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a></li>
    </ul>

  </div>
  <script>

    document.addEventListener("DOMContentLoaded", function () {
console.log("----")
      fetch("/auth/current-user",{cache:'reload',method:'GET'})
        .then(res => res.json())
        .then(data => {
          console.log(data)
          const email = data.Email;
          const fullName = data.FullName;
          const userType = data.UserType
          const userID = data.UserID;
          document.getElementById("fullName").textContent = `Logged in as: ${fullName}`
          document.getElementById("email").textContent=`Email: ${email}`;
          document.getElementById("userType").textContent=`Role: ${userType}`;
          document.getElementById("userID").textContent=`UserID: ${userID}`;
          document.getElementById("projectManagement").hidden = userType == 'photographerOnly' ? true : false
        })
        .catch(error => {
          console.log('caught',error)
        });
    });
  </script>
</body>

</html>