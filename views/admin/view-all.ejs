  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      margin: 30px;
      background: #f5f5f5;
    }

    .main_con {
      margin-left: 300px;
    }

    .btn {
      display: inline-block;
      background: #007bff;
      color: white;
      padding: 10px 16px;
      border: none;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      float: right;
      margin-top: 50px;
      margin-bottom: 50px;
      margin-left: 10px;
    }

    h2 {
      /* text-align: center; */
      margin: 20px 0;
      color: #333;
    }

    table {

      width: 100%;
      border-collapse: collapse;
      background: white;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      border-radius: 8px;
      overflow: hidden;
      margin-top: 30px;
    }

    th,
    td {
      padding: 12px 15px;
      border-bottom: 1px solid #eee;
      text-align: left;
    }

    th {
      background-color: #007bff;
      color: white;
      font-weight: 600;
    }

    tr:hover {
      background-color: #f1f1f1;
    }

    .action-btns button {
      margin-right: 6px;
      padding: 5px 10px;
      font-size: 14px;
      border-radius: 4px;
      cursor: pointer;
    }

    .btn-view {
      background-color: #17a2b8;
      color: #fff;
    }

    .btn-edit {
      background-color: #ffc107;
      color: #000;
    }

    .btn-delete {
      background-color: #dc3545;
      color: #fff;
    }

    .no-data {
      text-align: center;
      color: gray;
      margin-top: 20px;
    }

    .status-approved {
      color: green;
      font-weight: bold;
    }

    .status-rejected {
      color: red;
      font-weight: bold;
    }

    .btn-restore {
      background: #54d300;
    }
  </style>
</head>

<main class="user-management-container">
  <h2 class="page-title" style="text-align: center;">Login User Management</h2>
  <div class="table-container">
    <% if (users.length===0) { %>
    <p class="no-data">No users found</p>
    <% } else { %>
    <table class="user-table" id="user-table">
      <thead>
        <tr>
          <th>User ID</th>
          <th>Email</th>
          <th>User Type</th>
          <th>Full Name</th>
          <th>Organisation</th>
          <th>Registered Date</th>
          <th>Last Login</th>
          <th>Request Status</th>
          <th>Is Deleted</th>
          <th style="text-align: center;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user=> { %>
        <tr id="row-<%= user.LoginUserID %>">
          <td>
            <%= user.UserID %>
          </td>
          <td>
            <%= user.Email %>
          </td>
          <td>
            <%= user.UserType %>
          </td>

          <td><%=user.FullName%></td>
          <td>
            <%= user.Organisation %>
          </td>
          <td>
            <%= new Date(user.RegisteredDate).toLocaleDateString('en-IN', { day: '2-digit' ,
                                            month: 'short' , year: 'numeric' }) %>
          </td>
          <td>
            <%= user.LastLoginDate ? new
                                            Date(user.LastLoginDate).toLocaleDateString('en-IN') : '-' %>
          </td>

          <td><span class="status <%= user.RequestStatus == 'pending' || user.RequestStatus == 'rejected' ? 'inactive' : 'active' %>">
              <%= user.RequestStatus%>
            </span></td>

          <td class="<%= !user.IsDeleted  ? 'status-approved' :  'status-rejected'  %>">
            <%=!user.IsDeleted? 'No' : 'Yes' %>
          </td>
          <td class="actions">
            <a href="/admin/user-management/edit/<%= user.UserID %>" class="btn-edit">
              <i class="fas fa-edit"></i> Edit
            </a>
            <%if (!user.IsDeleted ){%>
            <form action="/admin/user-management/delete/<%= user.UserID%>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
              <button type="submit" class="btn-delete">Delete</button>
            </form>
            <%} else {%>
            <form action="/admin/user-management/restore/<%= user.UserID %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to restore this user?');">
              <button type="submit" class="btn-restore">restore</button>
            </form>
            <%}%>
                                        
                                    </td>
                                </tr>
                                <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>
</main>



