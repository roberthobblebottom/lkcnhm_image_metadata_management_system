<%- include('../sidenavs/admin') %>

<head>
  <link rel="stylesheet" href="/css/table.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>

</head>

<div class="main-con">

  <div class="horizontal-panel">
    <h2 class="page-title">Login User Management</h2>
    <a href="/admin/user-management/create/" class="btn">Add User</a>
  </div>

  <% if (users.length===0) { %>
  <p class="no-data">No users found</p>
  <% } else { %>
  <table class="user-table" id="user-table">
    <thead>
      <tr>
        <th>User ID</th>
        <th>Email</th>
        <th>User Type</th>
        <th>Full Name</th>
        <th>Organisation</th>
        <th>Registered Date</th>
        <th>Last Login</th>
        <th>Request Status</th>
        <th>Is Deleted</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(user=> { %>
      <tr id="row-<%= user.LoginUserID %>">
        <td>
          <%= user.UserID %>
        </td>
        <td>
          <%= user.Email %>
        </td>
        <td>
          <%= user.UserType %>
        </td>

        <td><%=user.FullName%></td>
        <td>
          <%= user.Organisation %>
        </td>
        <td>
          <%= new Date(user.RegisteredDate).toLocaleDateString('en-IN', { day: '2-digit' ,
                                            month: 'short' , year: 'numeric' }) %>
        </td>
        <td>
          <%= user.LastLoginDate ? new
                                            Date(user.LastLoginDate).toLocaleDateString('en-IN') : '-' %>
        </td>

        <td><span class="status <%= user.RequestStatus == 'pending' || user.RequestStatus == 'rejected' ? 'inactive' : 'active' %>">
            <%= user.RequestStatus%>
          </span></td>

        <td class="<%= !user.IsDeleted  ? 'status-approved' :  'status-rejected'  %>">
          <%=!user.IsDeleted? 'No' : 'Yes' %>
        </td>
        <td class="horizontal-panel">
          <a href="/admin/user-management/view/<%= user.UserID %>" class="btn-view">
            <i class="fas fa-view"></i> View
          </a>
          <a href="/admin/user-management/edit/<%= user.UserID %>" class="btn-edit">
            <i class="fas fa-edit"></i> Edit
          </a>
          <%if (!user.IsDeleted ){%>
          <form action="/admin/user-management/delete/<%= user.UserID%>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
            <button type="submit" class="btn-delete">Delete</button>
          </form>
          <%} else {%>
          <form action="/admin/user-management/restore/<%= user.UserID %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to restore this user?');">
            <button type="submit" class="btn-restore">restore</button>
          </form>
          <%}%>
                                        
                                    </td>
                                </tr>
                                <% }); %>
    </tbody>
  </table>
  <% } %>
</div>



