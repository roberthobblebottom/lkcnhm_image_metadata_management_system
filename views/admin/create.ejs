<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create User </title>
  <link rel="stylesheet" href="/css/form.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <%- include('../sidenavs/admin') %>
  <style>
    form {
      width: 200%;
    }
  </style>
</head>

<body>
  <div class="main-con">
    <form id="form">
      <div class="horizontal-panel">
        <a href="/admin/user-management/view-all" class="btn btn-primary">
          <i class="fas fa-arrow-left"></i> Back to all Users
        </a>
        <h2>Create User</h2>
      </div>

      <div class="form-group">
        <label for="email">Email* </label>
        <input type="text" name="email" id="email" value="" required>
      </div>
      <div class="form-group">
        <label for="Password">Password* :</label>
        <input type="password" id="password" name="password" value="" required>
      </div>
      <div class="form-group">
        <label for="confirmPassword">Confirm Password*:</label>
        <input type="password" id="confirmPassword" name="confirmPassword" value="" required>
      </div>


      <div class="form-group">
        <label for="userType">User Type* </label>
        <select name="userType" id="userType" requried>
          <option value="">-- Select a User Type--</option>
          <%userTypes.forEach( u=>{%>
          <option value="<%=u%>">
            <%=u%>
          </option>
          <%})%>
        </select>
      </div>
      <div class="form-group">
        <label for="fullName">Full Name* </label>
        <input type="text" name="fullName" id="fullname" value="" required>
      </div>

      <div class="form-group">
        <label for="contactNumber">Contact Number </label>
        <input type="text" id="contactNumber" value="">
      </div>
      <div class=" form-group">
        <label for="organisation">Organisation </label>
        <input type="text" id="organisation" value="">
      </div>
      <div class="form-group">
        <label for="comments">Comments </label>
        <textarea id="comments"></textarea>
      </div>
      <div class="form-group">
        <label>Request Status* </label>
        <select name="requestStatus" id="requestStatus" requried>
          <option value="">-- Select a Request Status--</option>
          <%requestStatuses.forEach( u=>{%>
          <option value="<%=u%>">
            <%=u%>
          </option>
          <%})%>
        </select>
      </div>


      <div class="form-group">
        <label> Reason for Request: </label>
        <textarea id="reasonForRequest"></textarea>
      </div>

      <div class="buttons">
        <button type="submit">Create User</button>
      </div>
    </form>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {

      const form = document.getElementById("form");
      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Validate form
        //   const passwordRegex = /^(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/;
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerHTML;
        submitBtn.classList.add('loading');
        submitBtn.innerHTML = '<i class="fas fa-spinner"></i> Submitting...';
        submitBtn.disabled = true;
        if (!/^[\w\-\.]+@([\w-]+\.)+[\w-]{2,}$/.test(form.email.value)) {

          submitBtn.disabled = false;
          submitBtn.innerHTML = 'Edit Profile';
          await Swal.fire({
            title: 'Error!',
            text: "invalid email, email value does not have '@' or '.' character(s).",
            icon: 'error',
            confirmButtonText: 'OK',
            confirmButtonColor: '#dc3545'
          });
          return
        }
        //   if (!passwordRegex.test(password)) {
        //     Swal.fire({
        //       title: 'Invalid Password',
        //       text: 'Password must contain at least 8 characters with one uppercase, one number, and one special character',
        //       icon: 'error',
        //       confirmButtonColor: '#00bbff'
        //     });
        //     return;
        //   }

        if (form.password.value != form.confirmPassword.value) {
          Swal.fire({
            icon: 'error',
            title: 'Error!',
            text: "wrong confimation of password doesn't match first instance of  password."
          });
          console.log("mismatched passwords")
          return
        }
        // Prepare form data
        const params = JSON.stringify({
          email: form.email.value,
          password: form.password.value,
          confirmPassword: form.confirmPassword.value,
          userType: form.userType.value,
          fullName: form.fullName.value,
          contactNumber: form.contactNumber.value,
          organisation: form.organisation.value,
          comments: form.comments.value,
          requestStatus: form.requestStatus.value,
          reasonForRequest: form.reasonForRequest.value,
        })
        try {
          // Show loading indicator
          Swal.fire({
            title: 'Updating User',
            html: 'Please wait...',
            allowOutsideClick: false,
            didOpen: () => {
              Swal.showLoading();
            }
          });

          // Send AJAX request
          console.log(params)
          const response = await fetch('/admin/user-management/create/', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: params
          });

          const result = await response.json();

          // Close loading indicator
          Swal.close();

          if (result.success) {
            // Show success alert
            Swal.fire({
              title: 'Success!',
              text: "Creation of user is successful",
              icon: 'success',
              showConfirmButton: true,
              timer: 1000
            }).then(() => {
              window.location.href = "/admin/user-management/view-all"; // Redirect to the desired page after success
            });
          } else {
            // Show error alert
            Swal.fire({
              title: 'Error!',
              text: result.message,
              icon: 'error',
              confirmButtonColor: '#00bbff'
            });
          }
        } catch (error) {
          Swal.close();
          Swal.fire({
            title: 'Error!',
            text: 'An unexpected error occurred',
            icon: 'error',
            confirmButtonColor: '#00bbff'
          });
          console.error('Error:', error);
        } finally {
          submitBtn.disabled = false;
          submitBtn.value = "Upload"
          submitBtn.innerHTML = 'Edit Profile';
        }
      });
    });
  </script>
</body>

</html>