<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create User </title>
  <link rel="stylesheet" href="/css/form.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <%- include('../sidenavs/admin') %>
    <style>
      form {
        width: 200%;
      }
    </style>
</head>

<body>
  <div class="main-con">
    <form id="form">
      <div class="horizontal-panel">
        <a href="/admin/user-management/view-all" class="btn btn-primary">
          <i class="fas fa-arrow-left"></i> Back to all Users
        </a>
        <h2>Create User</h2>
      </div>
      <p class="requirement-of-field">* = required</p>

      <div class="form-group">
        <label for="email">Email* </label>
        <input type="text" name="email" id="email" value="" required>
      </div>
      <div class="form-group">
        <label for="Password">Password* :</label>
        <input type="password" id="password" name="password" value=""
          title="Password must be at least 7 characters long and include at least an lowercase letter and a number"
          pattern="^(?=.*[a-z])(?=.*[0-9])\S{7,}$" required>
      </div>
      <div class="form-group">
        <label for="confirmPassword">Confirm Password*</label>
        <input type="password" id="confirmPassword" name="confirmPassword" value="" required>
      </div>
      <div class="form-group">
        <label for="userType">User Type* </label>
        <select name="userType" id="userType" requried>
          <option value="">-- Select a User Type--</option>
          <%userTypes.forEach( u=>{%>
            <option value="<%=u%>">
              <%=u%>
            </option>
            <%})%>
        </select>
      </div>
      <div class=" form-group">
        <label for="staffType">StaffType* </label>
        <select name="staffType" id="staffType">
          <option value="">-- Select a staff type--</option>
          <%staffTypes.forEach( staffType=>{%>
            <option value="<%=staffType%>">
              <%=staffType%>
            </option>
            <%})%>
        </select>
      </div>
      <div class="form-group">
        <label for="fullName">Full Name* </label>
        <input type="text" name="fullName" id="fullname" value="" required>
      </div>
      <div class="form-group">
        <label for="contactNumber">Contact Number </label>
        <input type="text" id="contactNumber" value="">
      </div>

      <div class="form-group">
        <label for="comments">Comments </label>
        <textarea id="comments"></textarea>
      </div>

      <div class="buttons">
        <button type="submit">
          <i class="fas fa-paper-plane"></i>
          Create User</button>
      </div>
    </form>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("form");
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        Swal.fire({
          title: "Confirm Your password",
          html: `
<div style="height: 100px">
<label>Are you sure you want to create this user? If so please reenter your password.</label>
<input type="password" id="reconfirmPasswordInput" placeholder="Password" style="width:98%;height:15px">
</div>`,
          confirmButtonText: 'confirm',
          preConfirm: (value) => {
            if (!value) {
              Swal.showValidationMessage('please enter your password')
              return
            }
            const passwordValue = document.getElementById('reconfirmPasswordInput').value
            submit(form, passwordValue)
          }
        });
      })

      async function submit(form, reconfirmPasswordForAdmin) {
        // Validate form
        //   const passwordRegex = /^(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/;
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerHTML;
        submitBtn.classList.add('loading');
        submitBtn.innerHTML = '<i class="fas fa-spinner"></i> Submitting...';
        submitBtn.disabled = true;

        const email = document.getElementById("email").value.trim();
        const emailRegex = /[a-z0-9!#$%&'*+\/=?^_`{|}~-]+(?:\.[a-z0-9!#$%&'*+\/=?^_`{|}~-]+)*@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?/
        if (!emailRegex.test(email)) {
          submitBtn.disabled = false;
          submitBtn.value = "Upload"
          submitBtn.innerHTML = originalBtnText;
          Swal.fire({
            icon: 'error',
            title: 'Invalid Email',
            text: 'Please enter a valid email address. e.g. test@gmail.com'
          });
          return;
        }

        //   if (!passwordRegex.test(password)) {
        //     Swal.fire({
        //       title: 'Invalid Password',
        //       text: 'Password must contain at least 8 characters with one uppercase, one number, and one special character',
        //       icon: 'error',
        //       confirmButtonColor: '#00bbff'
        //     });
        //     return;
        //   }

        if (form.password.value != form.confirmPassword.value) {
          Swal.fire({
            icon: 'error',
            title: 'Error!',
            text: "wrong confimation of password doesn't match first instance of  password."
          });
          return
        }
        // Prepare form data
        const params = JSON.stringify({
          email: form.email.value,
          password: form.password.value,
          confirmPassword: form.confirmPassword.value,
          userType: form.userType.value,
          fullName: form.fullName.value,
          contactNumber: form.contactNumber.value,
          staffType: form.staffType.value,
          comments: form.comments.value,
          reconfirmPasswordForAdmin: reconfirmPasswordForAdmin
        })
        try {
          // Show loading indicator
          Swal.fire({
            title: 'Updating User',
            html: 'Please wait...',
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
          });

          // Send AJAX request
          const response = await fetch('/admin/user-management/create/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: params
          });

          const result = await response.json();

          // Close loading indicator
          Swal.close();

          if (result.success) {
            // Show success alert
            Swal.fire({
              title: 'Success!',
              text: "Creation of user is successful",
              icon: 'success',
              showConfirmButton: true,
              timer: 1000
            }).then(() => {
              window.location.href = result.redirectUrl; // Redirect to the desired page after success
            });
          } else {
            // Show error alert
            Swal.fire({
              title: 'Error!',
              text: result.message,
              icon: 'error',
              confirmButtonColor: '#00bbff'
            });
          }
        } catch (error) {
          Swal.close();
          Swal.fire({
            title: 'Error!',
            text: 'An unexpected error occurred',
            icon: 'error',
            confirmButtonColor: '#00bbff'
          });
          console.error('Error:', error);
        } finally {
          submitBtn.disabled = false;
          submitBtn.value = "Upload"
          submitBtn.innerHTML = originalBtnText;
        }
      };
    })
  </script>
</body>

</html>