<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit User</title>
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #a8c0ff, #3f2b96);
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      padding: 20px;
      flex-direction: column;
    }

    h2 {
      text-align: center;
      color: white;
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 20px;
    }

    /* Container styling */
    .form-container {
      max-width: 800px;
      width: 900px;
      margin: 30px auto;
      background-color: #fdfdfd;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    /* Form layout */
    form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* Group of fields (2 per row) */
    .form-group {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    .form-group>div {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    /* Labels */
    label {
      font-weight: 600;
      margin-bottom: 8px;
      color: #333;
    }

    /* Inputs, Selects, and Textareas */
    input,
    select,
    textarea {
      padding: 10px 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 16px;
      background-color: #fff;
      transition: border-color 0.3s ease;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: #3f51b5;
      outline: none;
    }

    /* Submit button */
    button[type="submit"] {
      padding: 12px 20px;
      font-size: 16px;
      font-weight: 600;
      color: #fff;
      background-color: #3f51b5;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      align-self: flex-start;
      transition: background-color 0.3s ease;
    }

    button[type="submit"]:hover {
      background-color: #2c3e9f;
    }

    /* Responsive tweaks */
    @media (max-width: 600px) {
      .form-group {
        flex-direction: column;
      }
    }
  </style>
</head>

<body>
  <!-- Not sure if this need the if else statement like other views -->
  <%- include('partials/sidenav-admin.ejs') %>
    <h2>Edit User</h2>
    <div class="form-container">
      <form id="editUserForm" action="/edit/<%= user.id %>" method="post">
        <div class="form-group">
          <div>
            <label for="username">Full Name:</label>
            <input type="text" id="username" name="username" value="<%= user.username %>" required>
          </div>
          <div>
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" value="<%= user.email %>" required>
          </div>
        </div>
        <div class="form-group">
          <div>
            <label for="ContactNumber">Contact Number:</label>
            <input type="text" id="ContactNumber" name="ContactNumber" value="<%= user.ContactNumber %>" required>
          </div>
          <div>
            <label for="organisation">Organisation:</label>
            <input type="text" id="organisation" name="organisation" value="<%= user.organisation %>">
          </div>
        </div>
        <div class="form-group">
          <div>
            <label for="UserType">User Type:</label>
            <select id="UserType" name="UserType" required>
              <% userTypesEnumeration.forEach(type=> { %>
                <option value="<%= type.UserTypeID %>" <%=user.UserTypeID===type.UserTypeID ? "selected" : "" %>>
                  <%= type.UserTypeName %>
                </option>
                <% }) %>
            </select>
          </div>
          <div>
            <label for="request_status">Request Status:</label>
            <select id="request_status" name="request_status" required>
              <% requestStatuses.forEach(status=> { %>
                <option value="<%= status.RequestStatusID %>" <%=user.RequestStatusID===status.RequestStatusID
                  ? "selected" : "" %>>
                  <%= status.RequestStatusName %>
                </option>
                <% }) %>
            </select>

          </div>
        </div>
        <div class="form-group">
          <div>
            <label for="comments">Comments:</label>
            <textarea id="comments" name="comments"><%= user.comments %></textarea>
          </div>
          <div>
            <label for="reason_for_request">Reason for Request:</label>
            <textarea id="reason_for_request" name="reason_for_req"><%= user.reason_for_req %></textarea>
          </div>
        </div>
        <button type="submit">Update</button>
      </form>
    </div>
</body>

</html>