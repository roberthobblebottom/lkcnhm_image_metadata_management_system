<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User - <%= user ? user.LoginUserName : 'Unknown User' %>
    </title>

    <link rel="stylesheet" href="/css/admin-users.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <%- include('../partials/sidenav-admin') %>
        <style>
            * {
                box-sizing: border-box;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            body {
                margin: 0;
                padding: 0;
                background: white;
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: flex-start;
                padding-top: 60px;
            }

            main {
                width: 100%;
                max-width: 600px;
                padding: 20px;
            }

            .form-container {
                background-color: #fff;
                padding: 30px;
                border-radius: 16px;
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
                width: 100%;
            }

            .form-container h2 {
                text-align: center;
                margin-bottom: 25px;
                color: #000435;
                font-size: 24px;
            }

            .form-group {
                margin-bottom: 20px;
            }

            label {
                display: block;
                font-weight: 600;
                margin-bottom: 8px;
                color: #333;
            }

            input,
            select {
                width: 100%;
                padding: 12px 15px;
                border: 1.5px solid #ccc;
                border-radius: 8px;
                font-size: 15px;
                transition: border-color 0.3s ease;
            }

            input:focus,
            select:focus {
                border-color: #00c6ff;
                outline: none;
            }

            input[disabled] {
                background-color: #f0f0f0;
                color: #999;
            }

            button {
                width: 100%;
                background-color: #000435;
                color: white;
                padding: 14px;
                font-size: 16px;
                font-weight: bold;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                transition: background-color 0.3s ease;
            }

            button:hover {
                background-color: #0072ff;
            }

            @media screen and (max-width: 768px) {
                body {
                    align-items: flex-start;
                    padding: 40px 10px;
                }

                .form-container {
                    padding: 20px;
                }

                .form-container h2 {
                    font-size: 20px;
                }

                button {
                    padding: 12px;
                    font-size: 15px;
                }
            }
        </style>

</head>

<body>
    <main>
        <div class="form-container">
            <h2>Edit Login Details</h2>

            <form id="editUserForm">
                <input type="hidden" name="LoginUserID" value="<%= user.LoginUserID %>">

                
<div class="form-group">
        <label for="userID">User ID</label>
        <input type="text" id="userID" value="<%=currentUser.UserID%>" readonly>
      </div>
      <div class="form-group">
        <label for="email">Email </label>
        <input type="text" name="email" id="email" value="<%=currentUser.Email%>" required>
      </div>
                <div class="form-group">
                    <label for="Password">Password:</label>
                    <input type="password" id="Password" name="Password" value="" >
                </div>

   

<div class="form-group">
        <label for="userType">User Type</label>
        <input type="text" value="<%=currentUser.UserType%>" readonly>
      </div>
      <div class="form-group">
        <label for="fullName">Full Name </label>
        <input type="text" name="fullName" id="fullname" value="<%=currentUser.FullName%>" required>
      </div>
      <div class="form-group">
        <label>Registered Date </label>
        <input type="text" value="<%=registeredDate%>" readonly>
      </div>
      <div class="form-group">
        <label for="contactNumber">Contact Number </label>
        <input type="text" id="contactNumber" value="<%=currentUser.ContactNumber%>">
      </div>
      <div class=" form-group">
        <label for="organisation">Organisation </label>
        <input type="text" id="organisation" value="<%=currentUser.Organisation%>">
      </div>
      <div class="form-group">
        <label for="comments">Comments </label>
        <textarea id="comments" ><%=currentUser.Comments%></textarea>
      </div>
      <div class="form-group">
        <label>Request Status </label>
        <input type="text" value="<%=currentUser.RequestStatus%>" readonly>
      </div>
      <div class="form-group">
        <label> Reason for Request: </label>
        <textarea  readonly><%=currentUser.ReasonForRequest%></textarea>
      </div>
                <!--          
                 <div class="form-group">
                    <label for="IsDelete">Status:</label>
                    <select id="IsDelete" name="IsDelete">
                        <option value="0" <%= user.IsDelete == 0 ? 'selected' : '' %>>Active</option>
                        <option value="1" <%= user.IsDelete == 1 ? 'selected' : '' %>>Deleted</option>
                    </select>
                </div> -->

                <button type="submit">Update User</button>
            </form>
        </div>
    </main>

    <script>
        document.getElementById('editUserForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            // Validate form
            const tempPassword = document.getElementById('TempPassword').value;
            const passwordRegex = /^(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/;

            if (!passwordRegex.test(tempPassword)) {
                Swal.fire({
                    title: 'Invalid Password',
                    text: 'Password must contain at least 8 characters with one uppercase, one number, and one special character',
                    icon: 'error',
                    confirmButtonColor: '#00bbff'
                });
                return;
            }

            // Prepare form data
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                // Show loading indicator
                Swal.fire({
                    title: 'Updating User',
                    html: 'Please wait...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // Send AJAX request
                const response = await fetch('/update-users/<%= user.LoginUserID %>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                // Close loading indicator
                Swal.close();

                if (result.success) {
                    // Show success alert
                    Swal.fire({
                        title: 'Success!',
                        text: result.message,
                        icon: 'success',
                        confirmButtonColor: '#00bbff'
                    });
                } else {
                    // Show error alert
                    Swal.fire({
                        title: 'Error!',
                        text: result.message,
                        icon: 'error',
                        confirmButtonColor: '#00bbff'
                    });
                }
            } catch (error) {
                Swal.close();
                Swal.fire({
                    title: 'Error!',
                    text: 'An unexpected error occurred',
                    icon: 'error',
                    confirmButtonColor: '#00bbff'
                });
                console.error('Error:', error);
            }
        });
    </script>
</body>

</html>