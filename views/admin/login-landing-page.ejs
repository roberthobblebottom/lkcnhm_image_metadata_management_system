<%- include('../sidenavs/admin') %>

  <style scoped>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
    }

    .dashboard-container {



      background: white;
      padding: 2.5rem;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);

      background-color: white;
      padding: 30px 20px;
      max-width: 1400px;
      margin: 0 auto;
      margin-top: 5vh;
      margin-left: 320px;
      display: flex;
      flex-direction: column;
      align-items: center;
      height: 45vh;



    }

    .dashboard-container {

      animation: fadeIn 0.5s ease-out;
    }

