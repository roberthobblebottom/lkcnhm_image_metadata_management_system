<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View User</title>
  <link rel="stylesheet" href="/css/table.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap');

    /* Main Container */
    .main-con {
      display: flex;
      min-height: 100vh;
      background: #f8fafc;
      padding: 2rem;
      margin-left: 200px;
      margin: 0 auto;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      align-content: center;
      flex-direction: column;
    }

    .form-group {
      margin-top: 20px;
      margin-bottom: 10px;
    }

    /* Form Header */
    h2 {
      color: #1e293b;
      font-size: 1.875rem;
      text-align: center;
      margin-bottom: 2rem;
      position: relative;
      padding-bottom: 1rem;
    }

    h2::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 3px;
      background: linear-gradient(to right, #007bff, #6366f1);
      border-radius: 3px;
    }

    .horizontal-panel {
      width: 100%;
      display: flex;
      justify-content: space-between;
    }

    .horizontal-panel2 {
      float: right;
      width: 170px;
      display: flex;
      justify-content: space-between;
    }

    .btn-primary {
      background-color: #007bff;
      color: #fff;
      border: none;
      padding: 0.75rem 2rem;
      border-radius: 8px;
      cursor: pointer;
      transition: background-color 0.3s ease;
      font-weight: 600;
      font-family: 'Segoe UI', sans-serif;

    }
  </style>
</head>

<body>
  <%- include( '../sidenavs/admin' ) %>
    <div class="main-con">
      <h2>Edit Enumeration Values used by the System</h2>
      <p class="note">
        The Delete and Edit of any of these attributes will affect existing table datas' respective values.
      </p>
      <div class="form-group">
        <div class="horizontal-panel">
          <h3>Project Types</h3>
          <button onclick="addValue('projectType')" class="btn btn-create">Create</button>
        </div>
        <table id="projectTypesTable">
          <thead>
            <tr>
              <th><label>Value</label></th>
              <th><label>Action</label></th>
            </tr>
          </thead>
          <tbody>
            <% projectTypes.forEach(element=> {%>
              <tr>
                <td><label>
                    <%=element%>
                  </label></td>
                <td>
                  <div class="horizontal-panel2">
                    <button onclick="editValue(entity = 'projectType',
                 value ='<%=element%>')" class="btn btn-edit">
                      Edit</button>
                    <button onclick="reconfirmPassword(
                  entity='projectType',
                message='Are you sure you want to delete this enumeration value <%=element%> for project type?',
                value= '<%=element%>',
                enumAction='delete')" class="btn btn-delete">
                      Delete</button>
                  </div>
                </td>

              </tr>
              <% })%>
          </tbody>
        </table>

      </div>
      <div class="form-group">
        <div class="horizontal-panel">
          <h3>Imaging Platforms </h3>
          <button class="btn btn-create" onclick="addValue('imagingPlatform')">Create</button>
        </div>
        <table id="imagingPlatformsTable">
          <thead>
            <tr>

              <th><label>Value</label></th>
              <th><label>Action</label></th>
            </tr>
          </thead>
          <tbody>
            <% imagingPlatforms.forEach(element=> {%>
              <tr>
                <td><label>
                    <%=element%>
                  </label></td>
                <td>
                  <div class="horizontal-panel2">
                    <button onclick="editValue(entity='imagingPlatform',
                value='<%=element%>')" class="btn btn-edit">
                      Edit</button>
                    <button onclick="reconfirmPassword(entity='imagingPlatform',
                message='Are you sure you want to delete this enumeration value <%=element%> for imaging platform?',
                value='<%=element%>',enumAction='delete')"" class=" btn btn-delete">
                      Delete</button>
                  </div>
                </td>
              </tr>
              <% })%>
          </tbody>
        </table>
      </div>
      <div class="form-group">

        <div class="horizontal-panel">
          <h3>Image Editing Tools </h3>

          <button class="btn btn-create" onclick="addValue('imageEditingTool')">Create</button>
        </div>
        <table id="imageEditingToolsTable">
          <thead>
            <tr>

              <th><label>Value</label></th>
              <th><label>Action</label></th>
            </tr>
          </thead>
          <tbody>
            <% imageEditingTools.forEach(element=> {%>
              <tr>
                <td><label>
                    <%=element%>
                  </label></td>
                <td>
                  <div class="horizontal-panel2">
                    <button onclick="editValue(entity='imageEditingTool',
                value='<%=element%>')" class="btn btn-edit">
                      Edit</button>
                    <button onclick="reconfirmPassword(entity='imageEditingTool',
                message='Are you sure you want to delete this enumeration value <%=element%> for image editing tool?',
                value='<%=element%>',enumAction='delete')" class="btn btn-delete">
                      Delete</button>
                  </div>
                </td>
              </tr>
              <% })%>
          </tbody>
        </table>
      </div>
      <h2>Purge Data that are marked as Soft Delete from the Database</h2>

      <button onclick="reconfirmPassword('user',
    'Are you sure you want to PERNAMANTLY purge user data?')" class="btn btn-primary">
        <i class="fas fa-arrow-down"></i> Purge User Data
      </button>
      <button onclick="reconfirmPassword('project','Are you sure you want to PERNAMANTLY purge project data?')"
        class="btn btn-primary">
        <i class="fas fa-arrow-down"></i> Purge Project Data
      </button>
      <button onclick="reconfirmPassword('media',
      'Are you sure you want to PERNAMANTLY purge soft deleted media?'
    )" class="btn btn-primary">
        <i class="fas fa-arrow-down"></i> Purge Media Data
      </button>

      <h2>Download System's Data</h2>
      <button onclick="reconfirmPassword(entity='',
      message='Are you sure you want to download the system\'s data?',value='',enumAction='downloadData'
    )" class="btn btn-primary">
        <i class="fas fa-arrow-down"></i> Download
      </button>
    </div>
</body>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  new DataTable("#projectTypesTable")
  new DataTable("#imagingPlatformsTable")
  new DataTable("#imageEditingToolsTable")

  function reconfirmPassword(entity, message = "", value = '', enumAction = '') {
    const originalValue = value
    Swal.fire({
      title: "Confirm Your password",
      html: `
      <div style="height: 100px">
      <label>${message} If so please reenter your password</label>
      <input type="password" id="reconfirmPasswordInput" placeholder="Password" style="width:98%;height:30%">
      </div>
      `,
      confirmButtonText: 'confirm',
      preConfirm: (value) => {
        if (!value) {
          Swal.showValidationMessage('please enter your password')
          return
        }
        if ((['user', 'project', 'media']).includes(entity))
          purgeData(entity)
        const passwordValue = document.getElementById('reconfirmPasswordInput').value
        switch (enumAction) {
          // case 'edit':
          //   editValue(entity, originalValue, passwordValue)
          //   break
          case 'delete':
            sendDeleteValue(entity,
              originalValue,
              passwordValue)
            break
          case 'downloadData':
            downloadSystemData()
            break
        }
      }
    })
  }
  async function addValue(feature) {
    Swal.fire({
      title: "Add new " + feature,
      text: "Add new " + feature,
      input: 'text',
      showCancelButton: true,
      inputPlaceholder: "Enter it here."
    }).then((result) => {
      if (result.value) {
        sendAddValue(feature, result.value)
      }
    });

  }
  async function sendAddValue(feature, value) {
    console.log(feature, value)
    const response = await fetch("/admin/add-enumeration-value", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        feature: feature,
        value: value
      })
    });
    try {
      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || "Submission failed with status " + response.status);
      }

      const data = await response.json();
      if (!data.success) {
        throw new Error(data.message || "Submission failed");
      }


      // Show success message
      await Swal.fire({
        title: 'Success!',
        text: 'new enum value updated successfully!',
        icon: 'success',
        confirmButtonText: 'OK',
        confirmButtonColor: '#28a745',
        timer: 1000,
        timerProgressBar: true
      });

      console.log(data.redirectUrl)
      // Redirect if URL is provided
      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
        return; // Stop further execution
      }

    } catch (error) {
      await Swal.fire({
        title: 'Error!',
        text: error.message,
        icon: 'error',
        confirmButtonText: 'OK',
        confirmButtonColor: '#dc3545'
      });
    }
  }



  function editValue(feature, value) {
    console.log('value', value)
    Swal.fire({
      title: "Editing Value, " + value + " of the feature " + feature,
      showCancelButton: true,
      html: `
      <div style="height: 200px">
      <label> please reenter your password if you are sure to edit the value</label>
      <input type="text" id="editedValueInput" value='${value}' style="width:98%;height:20%" >
      <input type="password" id="reconfirmPasswordInput" placeholder="Password" style="width:98%;height:20%">
      </div>
      `,
      preConfirm: () => {
        const p = document.getElementById('reconfirmPasswordInput').value
        if (p == "")
          Swal.showValidationMessage('password required')
        sendEditValue(feature, value,
          document.getElementById('editedValueInput').value, p
        )
      }
    });
  }
  async function sendEditValue(feature, oldValue, newValue, password) {
    console.log(feature, oldValue, newValue, password)
    const response = await fetch("/admin/edit-enumeration-value", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        reconfirmPasswordForAdmin: password,
        feature: feature,
        oldValue,
        newValue
      })
    });
    try {
      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || "Submission failed with status " + response.status);
      }

      const data = await response.json();
      if (!data.success) {
        throw new Error(data.message || "Submission failed");
      }


      // Show success message
      await Swal.fire({
        title: 'Success!',
        text: 'enum value edited successfully!',
        icon: 'success',
        confirmButtonText: 'OK',
        confirmButtonColor: '#28a745',
        timer: 1000,
        timerProgressBar: true
      });

      console.log(data.redirectUrl)
      // Redirect if URL is provided
      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
        return; // Stop further execution
      }


    } catch (error) {
      await Swal.fire({
        title: 'Error!',
        text: error.message,
        icon: 'error',
        confirmButtonText: 'OK',
        confirmButtonColor: '#dc3545'
      });
    }
  }

  async function sendDeleteValue(feature, value, password) {

    console.log(feature, value)
    const response = await fetch("/admin/delete-enumeration-value", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        feature: feature,
        value: value,
        reconfirmPasswordForAdmin: password
      })
    });
    try {
      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || "Submission failed with status " + response.status);
      }

      const data = await response.json();
      if (!data.success) {
        throw new Error(data.message || "Submission failed");
      }


      // Show success message
      await Swal.fire({
        title: 'Success!',
        text: 'enum value deleted successfully!',
        icon: 'success',
        confirmButtonText: 'OK',
        confirmButtonColor: '#28a745',
        timer: 1000,
        timerProgressBar: true
      });

      console.log(data.redirectUrl)
      // Redirect if URL is provided
      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
        return; // Stop further execution
      }


    } catch (error) {
      await Swal.fire({
        title: 'Error!',
        text: error.message,
        icon: 'error',
        confirmButtonText: 'OK',
        confirmButtonColor: '#dc3545'
      });
    }
  }



  async function purgeData(entity) {
    try {
      const response = await fetch('/admin/purge-soft-deleted-' + entity + 's', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          reconfirmPasswordForAdmin: document.getElementById("reconfirmPasswordInput").value
        })
      })
      console.log(response)
      const result = await response.json();
      if (response.status == 400 && !result.success) {
        Swal.fire({
          title: 'Error!',
          text: result.message,
          icon: 'error',
          confirmButtonColor: '#00bbff'
        });
        return
      }
      var bytes = new Uint8Array(result.buffer.data);
      var blob = new Blob([bytes], {
        type: "application/zip"
      }); // change resultByte to bytes
      Swal.fire({
        title: 'Purge successful',
        text: 'Successfully purged soft deleted ' + entity + 's. You may download the csv of the purged data',
        icon: 'success',
        showConfirmButton: true,
        timer: 3000
      }).then(() => {
        var link = document.createElement('a');
        link.href = window.URL.createObjectURL(blob);
        link.download = "purged " + entity + " data " + new Date().toISOString() + ".zip";
        link.click();
      })

    } catch (error) {
      Swal.fire({
        title: 'Error!',
        text: 'An unexpected error occurred' + error,
        icon: 'error',
        confirmButtonColor: '#00bbff'
      });
    }
  }

  async function downloadSystemData() {
    try {
      const response = await fetch('/admin/download-system-data',

        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            reconfirmPasswordForAdmin: document.getElementById("reconfirmPasswordInput").value
          })
        }
      )
      const result = await response.json();
      var bytes = new Uint8Array(result.buffer.data); // pass your byte response to this constructor
      var blob = new Blob([bytes], {
        type: "application/zip"
      }); // change resultByte to bytes
      var link = document.createElement('a');
      link.href = window.URL.createObjectURL(blob);
      link.download = "data " + new Date().toISOString() + ".zip";
      link.click();
    } catch (error) {
      Swal.fire({
        title: 'Error!',
        text: 'An unexpected error occurred',
        icon: 'error',
        confirmButtonColor: '#00bbff'
      });
    }
  }
</script>