<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View User</title>

  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />

  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap');

    /* Main Container */
    .main_con {
      display: flex;
      min-height: 100vh;
      max-width: 500px;
      background: #f8fafc;
      padding: 2rem;
      margin-left: 350px;
      margin: 0 auto;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      align-content: center;
      flex-direction: column;
    }

    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f4f6f8;
      padding: 2rem;
      font-size: medium;
    }


    /* Form Header */
    h2 {
      color: #1e293b;
      font-size: 1.875rem;
      text-align: center;
      margin-bottom: 2rem;
      position: relative;
      padding-bottom: 1rem;
    }

    h2::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 3px;
      background: linear-gradient(to right, #007bff, #6366f1);
      border-radius: 3px;
    }

    h3 {
      text-align: center;
      float: left;
    }

    .form-group {
      margin-bottom: 20px;

    }

    label {
      font-size: medium;
    }

    .btn {
      font-size: medium;
    }

    .btn-primary {
      width: 100%;
      height: 1.5%;
      background-color: #007bff;
      color: #fff;
      font-size: medium;
    }

    .btn-create {
      float: right;
      margin-top: 4%;
      height: 20%;
    }


    .btn-edit {
      background-color: #ffc107;
      color: #000;
    }

    .btn-delete {
      background-color: #dc3545;
      color: #fff;
    }

    .horizontal-panel {
      width: 100%;
      display: flex;
      justify-content: space-between;
      margin-bottom: 5%;
    }

    .horizontal-panel2 {
      width: 100%;
      display: flex;
      justify-content: space-evenly;
    }

    /* Animation Effects */
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    form {
      animation: fadeIn 0.5s ease-out;
    }

    /* Note Section */
    .note {
      text-align: center;
      color: #64748b;
      background: #f8fafc;
      padding: 1rem;
      border-radius: 8px;
      border: 1px dashed #cbd5e1;
      margin: 2rem 0;
      font-size: 0.875rem;
    }
  </style>
</head>

<body>
  <%- include( '../sidenavs/admin' ) %>
  <div class="main_con">
    <h2>Edit Enumeration Values used by the System</h2>
    <p class="note">
      The Delete and Edit of any of these attributes will affect existing table data's respective values.
    </p>
    <div class="form-group">
      <div class="horizontal-panel">
        <h3>Project Types</h3>
        <button onclick="addValue('projectType')" class="btn btn-create">Create</button>
      </div>
      <table id="projectTypesTable">
        <thead>
          <tr>
            <th><label>Value</label></th>
            <th><label>Action</label></th>
          </tr>
        </thead>
        <tbody>
          <% projectTypes.forEach(element => {%>
          <tr>
            <td><label><%=element%></label></td>
            <td>
              <div class="horizontal-panel2">
                <button onclick="editValue('projectType','<%=element%>')" class="btn btn-edit">
                  Edit</button>
                <button onclick="deleteValue('projectType','<%=element%>')" class="btn btn-delete">
                  Delete</button>
              </div>
            </td>

          </tr>
          <% })%>
        </tbody>
      </table>

    </div>
    <div class="form-group">
      <div class="horizontal-panel">
        <h3>Imaging Platforms </h3>
        <button class="btn btn-create" onclick="addValue('imagingPlatform')">Create</button>
      </div>
      <table id="imagingPlatformsTable">
        <thead>
          <tr>

            <th><label>Value</label></th>
            <th><label>Action</label></th>
          </tr>
        </thead>
        <tbody>
          <% imagingPlatforms.forEach(element => {%>
          <tr>
            <td><label><%=element%></label></td>
            <td>
              <div class="horizontal-panel2">
                <button onclick="editValue('imagingPlatform','<%=element%>')" class="btn btn-edit">
                  Edit</button>
                <button onclick="deleteValue('imagingPlatform','<%=element%>')"" class=" btn btn-delete">
                  Delete</button>
              </div>
            </td>
          </tr>
          <% })%>
        </tbody>
      </table>
    </div>
    <div class="form-group">

      <div class="horizontal-panel">
        <h3>Image Editing Tools </h3>

        <button class="btn btn-create" onclick="addValue('imageEditingTool')">Create</button>
      </div>
      <table id="imageEditingToolsTable">
        <thead>
          <tr>

            <th><label>Value</label></th>
            <th><label>Action</label></th>
          </tr>
        </thead>
        <tbody>
          <% imageEditingTools.forEach(element => {%>
          <tr>
            <td><label><%=element%></label></td>
            <td>
              <div class="horizontal-panel2">
                <button onclick="editValue('imageEditingTool','<%=element%>')" class="btn btn-edit">
                  Edit</button>
                <button onclick="deleteValue('imageEditingTool','<%=element%>')" class="btn btn-delete">
                  Delete</button>
              </div>
            </td>
          </tr>
          <% })%>
        </tbody>
      </table>
    </div>
    <h2>Download System's Data</h2>
    <!-- <a href="/admin/download-system-data" class="btn btn-primary">
      <i class="fas fa-arrow-down"></i> Download
    </a> -->
    <button onclick="downloadSystemData()" class="btn btn-primary">

      <i class="fas fa-arrow-down"></i> Download
    </button>
  </div>



</body>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  new DataTable("#projectTypesTable")
  new DataTable("#imagingPlatformsTable")
  new DataTable("#imageEditingToolsTable")

  async function addValue(feature) {
    Swal.fire({
      title: "Add new " + feature,
      text: "Add new " + feature,
      input: 'text',
      showCancelButton: true,
      inputPlaceholder: "Enter it here."
    }).then((result) => {
      if (result.value) {
        sendAddValue(feature, result.value)
      }
    });

  }
  async function sendAddValue(feature, value) {
    console.log(feature, value)
    const response = await fetch("/admin/add-enumeration-value", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        feature: feature,
        value: value
      })
    });
    try {
      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || "Submission failed with status " + response.status);
      }

      const data = await response.json();
      if (!data.success) {
        throw new Error(data.message || "Submission failed");
      }


      // Show success message
      await Swal.fire({
        title: 'Success!',
        text: 'new enum value updated successfully!',
        icon: 'success',
        confirmButtonText: 'OK',
        confirmButtonColor: '#28a745',
        timer: 1000,
        timerProgressBar: true
      });

      console.log(data.redirectUrl)
      // Redirect if URL is provided
      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
        return; // Stop further execution
      }


    } catch (error) {
      await Swal.fire({
        title: 'Error!',
        text: error.message,
        icon: 'error',
        confirmButtonText: 'OK',
        confirmButtonColor: '#dc3545'
      });
    }
  }

  function editValue(feature, value) {
    Swal.fire({
      title: "Editing Value, " + value + " of the feature " + feature,
      text: "Editing Value, " + value + " of the feature " + feature,
      input: 'text',
      showCancelButton: true,
      inputPlaceholder: "Enter it here."
    }).then((result) => {
      if (result.value) {
        sendEditValue(feature, value, result.value)
      }
    });
  }
  async function sendEditValue(feature, oldValue, newValue) {
    const response = await fetch("/admin/edit-enumeration-value", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        feature: feature,
        oldValue,
        newValue
      })
    });
    try {
      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || "Submission failed with status " + response.status);
      }

      const data = await response.json();
      if (!data.success) {
        throw new Error(data.message || "Submission failed");
      }


      // Show success message
      await Swal.fire({
        title: 'Success!',
        text: 'enum value edited successfully!',
        icon: 'success',
        confirmButtonText: 'OK',
        confirmButtonColor: '#28a745',
        timer: 1000,
        timerProgressBar: true
      });

      console.log(data.redirectUrl)
      // Redirect if URL is provided
      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
        return; // Stop further execution
      }


    } catch (error) {
      await Swal.fire({
        title: 'Error!',
        text: error.message,
        icon: 'error',
        confirmButtonText: 'OK',
        confirmButtonColor: '#dc3545'
      });
    }
  }
  async function deleteValue(feature, value) {

    Swal.fire({
      title: "Are you sure you want to delete this value " + value + " from " + feature,
      text: "Are you sure you want to delete this value " + value + " from " + feature,
      showCancelButton: true,
    }).then((result) => {
      sendDeleteValue(feature, value)
    });
  }
  async function sendDeleteValue(feature, value) {

    console.log(feature, value)
    const response = await fetch("/admin/delete-enumeration-value", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        feature: feature,
        value: value
      })
    });
    try {
      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || "Submission failed with status " + response.status);
      }

      const data = await response.json();
      if (!data.success) {
        throw new Error(data.message || "Submission failed");
      }


      // Show success message
      await Swal.fire({
        title: 'Success!',
        text: 'enum value deleted successfully!',
        icon: 'success',
        confirmButtonText: 'OK',
        confirmButtonColor: '#28a745',
        timer: 1000,
        timerProgressBar: true
      });

      console.log(data.redirectUrl)
      // Redirect if URL is provided
      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
        return; // Stop further execution
      }


    } catch (error) {
      await Swal.fire({
        title: 'Error!',
        text: error.message,
        icon: 'error',
        confirmButtonText: 'OK',
        confirmButtonColor: '#dc3545'
      });
    }
  }
  async function downloadSystemData() {
    try {
      const response = await fetch('/admin/download-system-data', )

     
      const result = await response.json();


      var bytes = new Uint8Array(result.buffer.data); // pass your byte response to this constructor
      var blob = new Blob([bytes], {
        type: "application/zip"
      }); // change resultByte to bytes
      var link = document.createElement('a');
      link.href = window.URL.createObjectURL(blob);
      link.download = "data.zip";
      link.click();
    } catch (error) {
      Swal.fire({
        title: 'Error!',
        text: 'An unexpected error occurred',
        icon: 'error',
        confirmButtonColor: '#00bbff'
      });
    }
  }
</script>