<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View User</title>

  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />

  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap');

    /* Main Container */
    .main_con {
      display: flex;
      min-height: 100vh;
      max-width: 500px;
      background: #f8fafc;
      padding: 2rem;
      margin-left: 350px;
      margin: 0 auto;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      align-content: center;
      flex-direction: column;
    }

    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f4f6f8;
      padding: 2rem;
    }


    /* Form Header */
    h2 {
      color: #1e293b;
      font-size: 1.875rem;
      text-align: center;
      margin-bottom: 2rem;
      position: relative;
      padding-bottom: 1rem;
    }

    h2::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 3px;
      background: linear-gradient(to right, #007bff, #6366f1);
      border-radius: 3px;
    }

    h3 {
      text-align: center;
    }

    .form-group {
      margin-bottom: 20px;
    }

    /* Labels */
    label {
      display: block;
      font-size: 0.875rem;
      font-weight: 600;
      color: #475569;
      margin-bottom: 0.5rem;
    }




    .btn-edit {
      background-color: #ffc107;
      color: #000;
    }

    .btn-delete {
      background-color: #dc3545;
      color: #fff;
    }

    .horizontal-panel {
      display: flex;
      justify-content: between;
    }

    /* Animation Effects */
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    form {
      animation: fadeIn 0.5s ease-out;
    }
  </style>
</head>

<body>

  <%- include( '../sidenavs/admin' ) %>
  <div class="main_con">
    <h2>Edit Enumeration Values used by the System</h2>
    <div class="form-group">
      <div class="horizontal-panel">
        <h3>Project Types</h3>
        <button onclick="addValue('projectType')" class="btn-create">Create</button>
      </div>
      <table id="projectTypesTable">
        <thead>
          <tr>
            <th>Value</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% projectTypes.forEach(element => {%>
          <tr>
            <td><%=element%></td>
            <td>
              <div class="horizontal-panel">
                <button class="btn-edit">Edit</button>
                <button onclick="deleteValue('projectType','<%=element%>')" class="btn-delete">Delete</button>
              </div>
            </td>

          </tr>
          <% })%>
        </tbody>
      </table>

    </div>
    <div class="form-group">

      <div class="horizontal-panel">
        <h3>Imaging Platforms </h3>

        <button class="btn-create" onclick="addValue('imagingPlatform')">Create</button>
      </div>
      <table id="imagingPlatformsTable">
        <thead>
          <tr>
            <th>Value</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% imagingPlatforms.forEach(element => {%>

          <tr>
            <td><%=element%></td>
            <td>
              <div class="horizontal-panel">

                <button class="btn-edit">Edit</button>
                <button onclick="deleteValue('imagingPlatform','<%=element%>')"" class="btn-delete">Delete</button>
              </div>
            </td>

          </tr>
          <% })%>
        </tbody>
      </table>
    </div>
    <div class="form-group">

      <div class="horizontal-panel">
        <h3>Image Editing Tools </h3>

        <button class="btn-create" onclick="addValue('imageEditingTool')">Create</button>
      </div>
      <table id="imageEditingToolsTable">
        <thead>
          <tr>
            <th>Value</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% imageEditingTools.forEach(element => {%>
          <tr>
            <td><%=element%></td>
            <td>
              <div class="horizontal-panel">

                <button class="btn-edit">Edit</button>
                <button onclick="deleteValue('imageEditingTool','<%=element%>')" class="btn-delete">Delete</button>

              </div>
            </td>
          </tr>
          <% })%>
        </tbody>
      </table>
    </div>
  </div>



</body>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  new DataTable("#projectTypesTable")
  new DataTable("#imagingPlatformsTable")
  new DataTable("#imageEditingToolsTable")

  async function addValue(feature) {
    Swal.fire({
      title: "Add new "+feature,
      text: "Add new "+feature,
      input: 'text',
      showCancelButton: true,
      inputPlaceholder: "Enter it here."
    }).then((result) => {
      if (result.value) {
        sendAddValue(feature, result.value)
      }
    });

  }
  async function sendAddValue(feature, value) {
    console.log(feature,value)
    const response = await fetch("/admin/add-enumeration-value", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        feature: feature,
        value: value
      })
    });
    try {
      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || "Submission failed with status " + response.status);
      }

      const data = await response.json();
      if (!data.success) {
        throw new Error(data.message || "Submission failed");
      }


      // Show success message
      await Swal.fire({
        title: 'Success!',
        text: 'new enum value updated successfully!',
        icon: 'success',
        confirmButtonText: 'OK',
        confirmButtonColor: '#28a745',
        timer: 1000,
        timerProgressBar: true
      });

      console.log(data.redirectUrl)
      // Redirect if URL is provided
      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
        return; // Stop further execution
      }


    } catch (error) {
      await Swal.fire({
        title: 'Error!',
        text: error.message,
        icon: 'error',
        confirmButtonText: 'OK',
        confirmButtonColor: '#dc3545'
      });
    }
  }

  function editValue(feature, value) {

  }
async function deleteValue(feature,value){

Swal.fire({
      title: "Are you sure you want to delete this value "+value+" from "+feature,
      text: "Are you sure you want to delete this value "+value+" from "+feature,
      showCancelButton: true,
    }).then((result) => {
        sendDeleteValue(feature, value)
    });
}

 async  function sendDeleteValue(feature, value) {
