<%- include('partials/sidenav_admin') %>

    <main class="user-management-container">
        <h2 class="page-title" style="text-align: center;">Login User Management</h2>
        <div class="table-container">
            <% if (users.length===0) { %>
                <p class="no-data">No users found</p>
                <% } else { %>
                    <table class="user-table">
                        <thead>
                            <tr>
                                <th>LOGIN USERID</th>
                                <th>LOGIN USERNAME</th>
                                <th>PASSWORD</th>
                                <th>TEMP PASSWORD</th>
                                <th>LOGIN USERTYPE</th>
                                <th>REGISTERED DATE</th>
                                <th>LAST LOGINDATE</th>
                                <th>UPDATED DATE</th>
                                <th>IS DELETED</th>
                                <th style="text-align: center;">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(user=> { %>
                                <tr id="row-<%= user.LoginUserID %>">
                                    <td>
                                        <%= user.LoginUserID %>
                                    </td>
                                    <td>
                                        <%= user.LoginUserName %>
                                    </td>
                                    <td>
                                        <%= user.Password %>
                                    </td>
                                    <td>
                                        <%= user.TempPassword ? user.TempPassword : '-' %>
                                    </td>
                                    <td><span class="user-type <%= user.LoginUserType.toLowerCase() %>">
                                            <%= user.LoginUserType %>
                                        </span></td>
                                    <td>
                                        <%= new Date(user.RegisteredDate).toLocaleDateString('en-IN', { day: '2-digit' ,
                                            month: 'short' , year: 'numeric' }) %>
                                    </td>
                                    <td>
                                        <%= user.LastLoginDate ? new
                                            Date(user.LastLoginDate).toLocaleDateString('en-IN') : '-' %>
                                    </td>
                                    <td>
                                        <%= user.UpdatedDate ? new Date(user.UpdatedDate).toLocaleDateString('en-IN')
                                            : '-' %>
                                    </td>
                                    <td><span class="status <%= user.IsDelete ? 'inactive' : 'active' %>">
                                            <%= user.IsDelete ? 'Yes' : 'No' %>
                                        </span></td>
                                    <td class="actions">
                                        <a href="/edit-users/<%= user.LoginUserID %>" class="edit-link">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <button onclick="deleteUser(<%= user.LoginUserID %>)" class="delete-btn">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                    <% } %>
        </div>
    </main>



    <script>
        function deleteUser(userID) {
            if (confirm("Are you sure you want to delete this user?")) {
                fetch(`/admin/user-maangement/delete-user/${userID}`, {
                    method: "PUT",
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('token')}`
                    }
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Network response was not ok');
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            // Fade out animation before removal
                            const row = document.getElementById(`row-${userID}`);
                            row.style.opacity = '0';
                            setTimeout(() => row.remove(), 300);

                            // Show success message
                            showAlert('User deleted successfully', 'success');
                        } else {
                            showAlert(data.error || 'Error deleting user', 'error');
                        }
                    })
                    .catch(error => {
                        console.error("Error:", error);
                        showAlert('Failed to delete user', 'error');
                    });
            }
        }

        function showAlert(message, type) {
            const alertBox = document.createElement('div');
            alertBox.className = `alert alert-${type}`;
            alertBox.textContent = message;

            document.body.appendChild(alertBox);

            setTimeout(() => {
                alertBox.classList.add('fade-out');
                setTimeout(() => alertBox.remove(), 500);
            }, 3000);
        }
    </script>