<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title || 'Forgot Password' %></title>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <div class="background">
    <div class="login-container">
      <h2>Forgot Password</h2>
      <form id="registerForm">
        <input type="text" id="userId" placeholder="Enter Email ID">
        <input type="text" id="tempPassword" placeholder="Enter Temp Password">
        <div style="position: relative; width: 100%;">
          <input
            type="text"
            id="newPassword"
            placeholder="Enter New Password"
            pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}"
            title="Password must be at least 8 characters long and include at least one uppercase letter, one lowercase letter, one number, and one special character."
            required
            style="width: 100%; padding-right: 40px;" 
          >
          <!-- <span
            id="toggleNewPassword"
            onclick="togglePassword('newPassword', this)"
            style="position: absolute; top: 50%; right: 10px; transform: translateY(-50%); cursor: pointer;"
          >👁️</span> -->
        </div>
        

        <button type="button" onclick="resetPassword()">Reset Password</button>
      </form>
  
      <!-- Message Box -->
      <div id="messageBox" style="display: none; padding: 10px; margin-top: 10px; border-radius: 5px;"></div>
  
      <!-- Note -->
      <p style="margin-top: 15px; font-size: 0.9rem; color: #555;">
        If you don't have a temp password, kindly contact admin at 
        <a href="mailto:<%= adminEmail || 'admin@gmail.com' %>" style="color: #007bff; text-decoration: none;">
          <%= adminEmail || 'admin@gmail.com' %>
        </a>
      </p>
    </div>
  </div>

  <script>
    function showMessage(text, isSuccess = true) {
      const box = document.getElementById("messageBox");
      box.style.display = "block";
      box.style.backgroundColor = isSuccess ? "#d4edda" : "#f8d7da";
      box.style.color = isSuccess ? "#155724" : "#721c24";
      box.style.border = isSuccess ? "1px solid #c3e6cb" : "1px solid #f5c6cb";
      box.innerText = text;

      // Auto-hide after 3 seconds
      setTimeout(() => {
          box.style.display = "none";
      }, 3000);
    }

    function resetPassword() {
  const userId = document.getElementById("userId").value.trim();
  const tempPassword = document.getElementById("tempPassword").value.trim();
  const newPassword = document.getElementById("newPassword").value.trim();

  // Regex pattern for strong password
  const passwordPattern = /^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}$/;

  // Client-side validation
  if (!userId || !tempPassword || !newPassword) {
    showMessage("❌ All fields are required!", false);
    return;
  }

  if (!passwordPattern.test(newPassword)) {
    showMessage("Password must be 8+ chars with upper, lower, number & special char.", false);
    return;
  }

  // Proceed with fetch if validation passed
  fetch("<%= forgotPasswordPath || '/forgot-password' %>", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ userId, tempPassword, newPassword })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      alert("✅ Password changed successfully!");
      showMessage("✅ Password changed successfully!", true);
      window.location.href = "<%= typeof redirectPath !== 'undefined' ? redirectPath : '/' %>";
    } else {
      showMessage("❌ Error: " + (data.error || "Password reset failed"), false);
    }
  })
  .catch(err => {
    showMessage("❌ Request failed. Please try again.", false);
    console.error(err);
  });

    }
  </script>
</body>
</html>
