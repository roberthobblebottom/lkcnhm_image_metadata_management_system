<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>My Projects</title>
  <link rel="stylesheet" href="/css/user.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      margin: 30px;
      background: #f5f5f5;

    }

    .main_con {
      margin-left: 600px;

    }

    .btn {
      display: inline-block;
      background: #007bff;
      color: white;
      padding: 10px 16px;
      border: none;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      float: right;
      margin-top: 50px;
      margin-left: 400px;
    }

    h2 {
      padding-left: 20px;
      text-align: center;
      margin: 20px 0;
      color: #333;
    }

    table {
      width: 200%;
      border-collapse: collapse;
      background: white;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      border-radius: 8px;
      overflow: hidden;
      margin-top: 30px;
    }

    th,
    td {
      padding: 12px 15px;
      border-bottom: 1px solid #eee;
      text-align: left;
    }

    th {
      background-color: #007bff;
      color: white;
      font-weight: 700;
    }

    tr:hover {
      background-color: #f1f1f1;
    }

    .status-approved {
      color: green;
      font-weight: bold;
    }

    .status-rejected {
      color: red;
      font-weight: bold;
    }

    .view-btn {
      background: #17a2b8;
      color: white;
      padding: 6px 12px;
      border-radius: 6px;
      text-decoration: none;
      font-size: 14px;
    }

    .view-btn:hover {
      background: #138496;
    }

    .no-data {
      text-align: center;
      color: gray;
      margin-top: 20px;
    }
  </style>
</head>

<body>
  <div class="main_con">
    <%- include('../partials/sidenav-user') %>

      <% if (showPendingAlert) { %>
        <button class="btn" disabled style="opacity: 0.6;" title="Wait for admin approval">➕ Add Project
          (Locked)</button>
        <% } else { %>
          <a href="/user/project/create""><button class=" btn"> Add Project</button></a>
          <% } %>
            <br>

            <h2>My Projects</h2>

            <% if (projects.length===0) { %>
              <p class="no-data">No projects found.</p>
              <% } else { %>
                <table>
                  <thead>
                    <tr>
                      <th>ID</th>
                      <th>Photographer</th>
                      <th>Date of Request</th>
                      <th>Start</th>
                      <th>End</th>
                      <th>Status</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% projects.forEach(req=> { %>
                      <tr>
                        <td>
                          <%= req.ProjectID %>
                        </td>
                        <td>
                          <%= req.photographerName %>
                        </td>
                        <td>
                          <%= req.DateOfRequest?.toDateString() %>
                        </td>
                        <td>
                          <%= req.ImagingStartDate?.toDateString()%>
                        </td>
                        <td>
                          <%= req.ImagingEndDate?.toDateString()%>
                        </td>
                        <td
                          class="<%= req.RequestStatus === 'approved' ? 'status-approved' : req.RequestStatus === 'rejected' ? 'status-rejected' : '-' %>">
                          <%= req.RequestStatus || '-' %>
                        </td>
                        <td>
                          <a href="/user/project/view/<%= req.ProjectID %>" class="view-btn">View</a>
                        </td>
                      </tr>
                      <% }) %>
                  </tbody>
                </table>
                <% } %>
  </div>

  <script>
    <% if (showPendingAlert) { %>
      Swal.fire({
        icon: 'info',
        title: 'Hold On!',
        text: 'Your user access request is still pending approval. Project cannot be added until approved.',
        confirmButtonColor: '#007bff'
      });
    <% } %>
  </script>
</body>

</html>