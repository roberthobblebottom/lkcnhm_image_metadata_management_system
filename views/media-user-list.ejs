<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Select Requestor</title>
  <link rel="stylesheet" href="/css/admin-users.css" />
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f9f9f9;
      margin: 40px;
    }

    h2 {
      text-align: center;
      margin-bottom: 20px;
      color: #2c3e50;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    }

    th, td {
      padding: 12px 16px;
      border-bottom: 1px solid #eee;
      text-align: left;
    }

    th {
      background-color: #007bff;
      color: white;
    }

    tr:hover {
      background-color: #f1f1f1;
    }

    .btn-choose {
      background-color: #28a745;
      color: white;
      padding: 8px 14px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: bold;
      transition: background-color 0.2s;
    }

    .btn-choose:hover {
      background-color: #218838;
    }

    .no-data {
      text-align: center;
      margin-top: 30px;
      font-size: 16px;
      color: #888;
    }
    .main_con {
      margin-left: 600px;
      
    }
  </style>
</head>
<body>
    <div class="main_con">
    <%- include('partials/sidenav') %>
  <h2>📸 Select Requestor for Media Entry</h2>

  <% if (users.length === 0) { %>
    <p class="no-data">No imaging requests found.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
            <th>ID</th>
          <th>Requestor Name</th>
          <th>Photographer</th>
          <th>Start Date</th>
          <th>End Date</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(row => { %>
          <tr>
            <td><%= row.ImagingRequestID %></td>
            <td><%= row.requestor_name %></td>
            <td><%= row.photographer_name %></td>
            <td><%= row.ImagingStartDate.toISOString().slice(0, 10) %></td>
            <td><%= row.ImagingEndDate.toISOString().slice(0, 10) %></td>
            <td>
              <a href="/admin/media-form/<%= row.ImagingRequestID %>" class="btn-choose">Choose</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

</div>
</body>
</html>
