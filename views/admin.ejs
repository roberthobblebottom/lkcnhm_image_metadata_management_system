async function fetchUsers() {
  try {
    const response = await fetch('/api/users');
    const users = await response.json();

    const tableBody = document.getElementById('userTableBody');
    const deletedTableBody = document.getElementById('deletedUserTableBody');

    // Clear old content
    tableBody.innerHTML = '';
    deletedTableBody.innerHTML = '';

    let activeCount = 0;
    let deletedCount = 0;

    users.forEach(user => {
      const row = document.createElement('tr');
      row.innerHTML = `
        <td>${user.id}</td>
        <td>${user.username}</td>
        <td>${user.email}</td>
        <td>${user.ContactNumber}</td>
        <td>${user.organisation}</td>
        <td>${user.UserType}</td>
        <td>${user.date_of_req?.slice(0, 10)}</td>
        <td style="font-weight: bold; color: ${user.request_status === 'approved' ? 'green' : user.request_status === 'rejected' ? 'red' : 'black'};">
          ${user.request_status}
        </td>
        <td>
          <a href="/view/${user.id}" class="action-btn view-btn">View</a>
          <a href="/edit/${user.id}" class="action-btn edit-btn">Edit</a>
          ${
            user.is_delete == 0
              ? `<a href="/delete/${user.id}" class="action-btn delete-btn" onclick="return confirm('Are you sure you want to delete?');">Delete</a>`
              : `<a href="/recover/${user.id}" class="action-btn recover-btn" onclick="return confirm('Are you sure you want to recover?');">Recover</a>`
          }
        </td>
      `;

      if (user.is_delete == 0) {
        tableBody.appendChild(row);
        activeCount++;
      } else {
        deletedTableBody.appendChild(row);
        deletedCount++;
      }
    });

    // Add message if no active users
    if (activeCount === 0) {
      tableBody.innerHTML = `
        <tr><td colspan="9" style="text-align:center; color: gray;">No active users found.</td></tr>
      `;
    }

    // Add message if no deleted users
    if (deletedCount === 0) {
      deletedTableBody.innerHTML = `
        <tr><td colspan="9" style="text-align:center; color: gray;">No deleted users found.</td></tr>
      `;
    }

  } catch (error) {
    console.error('Error fetching users:', error);
  }
}


      
      document.addEventListener('DOMContentLoaded', fetchUsers);
  </script>
