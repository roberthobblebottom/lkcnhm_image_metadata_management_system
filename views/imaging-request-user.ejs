<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Imaging Request Management</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Add this in your <head> section -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <link rel="stylesheet" href="/css/admin-users.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 40px;
      background: #f9f9f9;
    }

    /* Reset some basic elements */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f6f8;
      padding: 2rem;
    }

    h2 {
      text-align: center;
      margin-bottom: 2rem;
      color: #2c3e50;
      margin-top: -60px;
    }

    form#imagingRequestForm {
      max-width: 600px;
      margin: 30px auto;
      padding: 25px 30px;
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Form Group */
    .form-group {
      margin-bottom: 20px;
    }

    /* Labels */
    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      color: #333333;
    }

    /* Inputs, Select, Textareas */
    .form-group input[type="text"],
    .form-group input[type="datetime-local"],
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 15px;
      transition: border-color 0.3s ease;
    }

    .form-group input[readonly] {
      background-color: #f9f9f9;
      color: #555;
    }

    /* Focus Effect */
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: #007bff;
      outline: none;
    }

    /* Error Message */
    .error-message {
      color: #dc3545;
      font-size: 13px;
      margin-top: 4px;
      display: none;
    }

    /* Buttons */
    .buttons {
      text-align: right;
      margin-top: 25px;
    }

    button.new {
      background-color: #007bff;
      color: #fff;
      padding: 10px 20px;
      font-weight: 600;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    button.new:hover {
      background-color: #0056b3;
    }

    /* Add New Photographer Link */
    .form-group p a {
      display: inline-block;
      font-size: 14px;
      color: #007bff;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .form-group p a:hover {
      color: #0056b3;
      text-decoration: underline;
    }

    .add-btn {
      margin-top: 10px;
      background-color: #000435;
      color: #fff;
      padding: 8px 14px;
      font-size: 14px;
      font-weight: 600;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background-color 0.3s ease, transform 0.2s ease;
      box-shadow: 0 3px 10px rgba(40, 167, 69, 0.15);
    }

    .add-btn:hover {
      background-color: #04119c;
      transform: translateY(-1px);
    }

    .add-btn:active {
      transform: translateY(0);
    }

    /* Responsive Enhancements */
    @media (max-width: 600px) {
      form#imagingRequestForm {
        padding: 1.5rem;
      }

      h2 {
        font-size: 1.5rem;
      }
    }

    input[readonly] {
      background-color: #f0f0f0;
      color: #555;
      cursor: not-allowed;
    }
  </style>
</head>

<body>
  <%= include("../partials/sidenav_user")%>

    <main>
      <h2>Imaging Request Management</h2>

      <form id="imagingRequestForm">
        <!-- Requestor (Readonly text input + hidden ID for submission) -->
        <div class="form-group">
          <label for="requestor">Requestor</label>
          <input type="text" id="requestorDisplay" value="<%= requestor.username %>" readonly>
          <input type="hidden" name="requestor" value="<%= requestor.id %>">
        </div>

        <!-- Photographers Dropdown -->
        <div class="form-group">
          <label for="photographer">Photographer</label>
          <select id="photographer" name="photographer" required>
            <option value="">Select Photographer</option>
            <% photographers.forEach(user=> { %>
              <option value="<%= user.id %>">
                <%= user.username %>
              </option>
              <% }) %>
          </select>
          <div id="photographer-error" class="error-message">Please select a photographer</div>

          <button type="button" class="add-btn" onclick="window.location.href='/form'">
            Add New Photographer
          </button>
        </div>

        <div class="form-group">
          <label for="requestDate">Date of Request</label>
          <input type="datetime-local" id="requestDate" name="requestDate" required readonly>
        </div>

        <div class="form-group">
          <label for="startDate">Imaging Start Date</label>
          <input type="datetime-local" id="startDate" name="startDate" required>
          <div id="startDate-error" class="error-message">Start date must be after request date</div>
        </div>

        <div class="form-group">
          <label for="endDate">Imaging End Date</label>
          <input type="datetime-local" id="endDate" name="endDate" required>
          <div id="endDate-error" class="error-message">End date must be after start date</div>
        </div>

        <div class="form-group">
          <label for="summary">Summary of Project</label>
          <textarea id="summary" name="summary" required></textarea>
          <div id="summary-error" class="error-message">Please provide a project summary</div>
        </div>

        <div class="form-group">
          <label for="specimenDetails">Specimen Details</label>
          <textarea id="specimenDetails" name="specimenDetails" required></textarea>
          <div id="specimenDetails-error" class="error-message">Please provide specimen details</div>
        </div>

        <div class="form-group">
          <label for="location">Specimen Location Name</label>
          <input type="text" id="location" name="location" required>
          <div id="location-error" class="error-message">Please specify the location</div>
        </div>

        <div class="form-group">
          <label for="platform">Imaging Platform</label>
          <input type="text" id="platform" name="platform">
        </div>

        <div class="form-group">
          <label for="comments">Comments</label>
          <textarea id="comments" name="comments"></textarea>
        </div>

        <div class="buttons">
          <button type="submit" class="new"><i class="fas fa-paper-plane"></i> Submit</button>
        </div>
      </form>
    </main>
    <script>
      // Initialize form with current datetime
      document.addEventListener('DOMContentLoaded', function () {
        // Set current datetime to requestDate field
        const requestDateField = document.getElementById('requestDate');
        if (requestDateField) {
          requestDateField.value = new Date().toISOString().slice(0, 16);
        }

        // Set min attributes for date fields
        updateDateConstraints();

        // Load users for dropdowns
        // loadUsers();

        // Setup form validation
        setupFormValidation();
      });

      // Update date constraints when dates change
      function updateDateConstraints() {
        const requestDateEl = document.getElementById('requestDate');
        const startDateEl = document.getElementById('startDate');
        const endDateEl = document.getElementById('endDate');

        if (!requestDateEl || !startDateEl || !endDateEl) return;

        const requestDate = requestDateEl.value;
        const startDate = startDateEl.value;

        // Set minimum start date to be after request date
        startDateEl.min = requestDate;

        // Set minimum end date to be after start date (if start date is selected)
        endDateEl.min = startDate || requestDate;
      }

      // Function to load users for dropdowns with null checks
      function loadUsers() {
        fetch('/admin/get-users')
          .then(res => {
            if (!res.ok) {
              throw new Error('Network response was not ok');
            }
            return res.json();
          })
          .then(data => {
            // Safely populate requestors dropdown
            if (data.requestors && Array.isArray(data.requestors)) {
              const requestorSelect = document.getElementById('requestor');
              if (requestorSelect) {
                requestorSelect.innerHTML = '<option value="">Select Requestor</option>';
                data.requestors.forEach(user => {
                  const option = document.createElement('option');
                  option.value = user.id;
                  option.textContent = user.username;
                  requestorSelect.appendChild(option);
                });
              }
            }

            // Safely populate photographers dropdown
            if (data.photographers && Array.isArray(data.photographers)) {
              const photographerSelect = document.getElementById('photographer');
              if (photographerSelect) {
                photographerSelect.innerHTML = '<option value="">Select Photographer</option>';
                data.photographers.forEach(user => {
                  const option = document.createElement('option');
                  option.value = user.id;
                  option.textContent = user.username;
                  photographerSelect.appendChild(option);
                });
              }
            }
          })
          .catch(err => {
            console.error("Failed to load users:", err);
            Swal.fire({
              title: 'Error!',
              text: 'Failed to load user data. Please refresh the page.',
              icon: 'error',
              confirmButtonText: 'OK'
            });
          });
      }

      // Function to setup form validation with null checks
      function setupFormValidation() {
        const form = document.getElementById('imagingRequestForm');
        if (!form) return;

        // Add event listeners for date changes with null checks
        const requestDateEl = document.getElementById('requestDate');
        const startDateEl = document.getElementById('startDate');
        const endDateEl = document.getElementById('endDate');

        if (requestDateEl) requestDateEl.addEventListener('change', function () {
          updateDateConstraints();
          validateDates();
        });

        if (startDateEl) startDateEl.addEventListener('change', function () {
          updateDateConstraints();
          validateDates();
        });

        if (endDateEl) endDateEl.addEventListener('change', validateDates);

        // Validate on submit
        form.addEventListener('submit', async function (e) {
          e.preventDefault();

          // Reset error messages
          document.querySelectorAll('.error-message').forEach(el => {
            el.style.display = 'none';
          });

          // Validate required fields
          let isValid = true;

          // Check dropdowns
          if (!form.requestor.value) {
            const errorEl = document.getElementById('requestor-error');
            if (errorEl) errorEl.style.display = 'block';
            isValid = false;
          }

          if (!form.photographer.value) {
            const errorEl = document.getElementById('photographer-error');
            if (errorEl) errorEl.style.display = 'block';
            isValid = false;
          }

          // Check text areas
          if (!form.summary.value.trim()) {
            const errorEl = document.getElementById('summary-error');
            if (errorEl) errorEl.style.display = 'block';
            isValid = false;
          }

          if (!form.specimenDetails.value.trim()) {
            const errorEl = document.getElementById('specimenDetails-error');
            if (errorEl) errorEl.style.display = 'block';
            isValid = false;
          }

          // Check location
          if (!form.location.value.trim()) {
            const errorEl = document.getElementById('location-error');
            if (errorEl) errorEl.style.display = 'block';
            isValid = false;
          }

          // Validate dates
          validateDates();
          if (!form.checkValidity()) {
            isValid = false;
            const invalidElement = form.querySelector(':invalid');
            if (invalidElement) {
              invalidElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }

          if (!isValid) {
            return;
          }

          // Submit form if valid
          await submitForm(form);
        });
      }

      // Date validation function with null checks
      function validateDates() {
        const requestDateEl = document.getElementById('requestDate');
        const startDateEl = document.getElementById('startDate');
        const endDateEl = document.getElementById('endDate');

        if (!requestDateEl || !startDateEl || !endDateEl) return;

        const requestDate = new Date(requestDateEl.value);
        const startDate = new Date(startDateEl.value);
        const endDate = new Date(endDateEl.value);

        const startDateError = document.getElementById('startDate-error');
        const endDateError = document.getElementById('endDate-error');

        // Reset displays
        if (startDateError) startDateError.style.display = 'none';
        if (endDateError) endDateError.style.display = 'none';
        startDateEl.setCustomValidity('');
        endDateEl.setCustomValidity('');

        // Validate start date
        if (startDateEl.value && startDate < requestDate) {
          if (startDateError) startDateError.style.display = 'block';
          startDateEl.setCustomValidity('Start date must be after request date');
        }

        // Validate end date
        if (endDateEl.value && endDate < startDate) {
          if (endDateError) endDateError.style.display = 'block';
          endDateEl.setCustomValidity('End date must be after start date');
        }
      }

      // Function to handle form submission
      async function submitForm(form) {
        const submitBtn = form.querySelector('button[type="submit"]');
        if (!submitBtn) return;

        const originalBtnText = submitBtn.innerHTML;

        try {
          // Show loading state
          submitBtn.classList.add('loading');
          submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
          submitBtn.disabled = true;

          // Create a plain object from form data
          const formData = {
            requestor: form.requestor.value,
            photographer: form.photographer.value,
            requestDate: form.requestDate.value,
            startDate: form.startDate.value,
            endDate: form.endDate.value,
            summary: form.summary.value,
            specimenDetails: form.specimenDetails.value,
            location: form.location.value,
            platform: form.platform.value || null,
            comments: form.comments.value || null
          };

          const response = await fetch('/submit-imaging-request', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
          });

          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || "Submission failed with status " + response.status);
          }

          const data = await response.json();

          if (!data.success) {
            throw new Error(data.message || "Submission failed");
          }

          // Show success message
          await Swal.fire({
            title: 'Success!',
            text: 'Imaging request submitted successfully!',
            icon: 'success',
            confirmButtonText: 'OK',
            confirmButtonColor: '#28a745',
            timer: 3000,
            timerProgressBar: true
          });

          // Redirect if URL is provided
          if (data.redirectUrl) {
            window.location.href = data.redirectUrl;
            return; // Stop further execution
          }

          // Reset form (if no redirection)
          form.reset();

          // Reset request date to current time
          const requestDateField = document.getElementById('requestDate');
          if (requestDateField) {
            requestDateField.value = new Date().toISOString().slice(0, 16);
            updateDateConstraints();
          }


        } catch (error) {
          console.error("Submission error:", error);
          await Swal.fire({
            title: 'Error!',
            text: error.message,
            icon: 'error',
            confirmButtonText: 'OK',
            confirmButtonColor: '#dc3545'
          });
        } finally {
          // Reset button state
          submitBtn.classList.remove('loading');
          submitBtn.innerHTML = originalBtnText;
          submitBtn.disabled = false;
        }
      }
    </script>

</body>

</html>