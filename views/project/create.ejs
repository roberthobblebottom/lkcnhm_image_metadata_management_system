<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Project Management</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/form.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@11.1.0/public/assets/styles/choices.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
</head>

<body>
  <div class="main-con">
    <%- include(currentUser.UserType==='admin' ? '../sidenavs/admin.ejs' : '../sidenavs/user.ejs' ) %>

      <form id="main-form">
        <div class="horizontal-panel">
          <a href="/project/view-all" class="btn btn-primary">
            <i class="fas fa-arrow-left"></i> Back to all Image Metadata
          </a>
          <h2>Create a New Project </h2>
        </div>
        <p class="requirement-of-field">* = required</p>
        <div class="form-group">

          <label for="projectName">Project Name*</label>
          <input type="text" id="projectName" name="projectName" required value="">
        </div>

        <div class="form-group">
          <label for="projectOwner">Project Owner Full Name* </label>
          <select id="projectOwner" name="projectOwner" <%=currentUser.UserType=='admin' ? '' : 'disabled' %> required>
            <option value="">Select Project Owner </option>
            <% projectOwners.forEach(user=> { %>
              <option value="<%=user.UserID %>" <%=user.UserID==currentUser.UserID ? 'selected' :''%>>
                <%=user.FullName%>
              </option>
              <% }) %>
          </select>
          <div id="projectOwnerError" class="error-message">Please select a projectOwner</div>
        </div>

        <%if(currentUser.UserType=='admin'){%>
          <div class="form-group">
            <div class="horizontal-panel2">
              <label class="label2">Project Type</label>
            </div>
            <select name="projectType" id="projectType" class="form-control">
              <option value="">-- Select Project Type --</option>
              <% projectTypes.forEach(projectType=> { %>
                <option value="<%= projectType %>">
                  <%= projectType %>
                </option>
                <% }) %>
            </select>
          </div>
          <%}%>

            <div class="form-group">
              <div class="horizontal-panel2">
                <label for="newSelectedPhotographers">Photographer(s)*</label>
                <% if(isUserRegistrationEnabled){%>
                  <button class="addButton" id="addPhotographerButton">Register New Photographer</button>
                  <%}%>
              </div>
              <select multiple id="newSelectedPhotographers">
                <option value="">Assign Registered Photographer(s)</span>
                  <% photographers.forEach(photographer=>{ %>
                <option class="dropdown-item" value="<%=photographer.UserID%>"
                  <%=photographer.UserID==currentUser.UserID && currentUser.UserType !='admin' ? 'selected' :''%>>
                  <%=photographer.FullName%>
                </option>
                <%})%>
              </select>
              <div id="photographer-error" class="error-message">Please select a photographer</div>
            </div>

            <div class="form-group">
              <label for="startDate">Imaging Start Date*</label>
              <input type="date" id="startDate" name="startDate" required>
              <div id="startDate-error" class="error-message">Start date must be after request date</div>
            </div>

            <div class="form-group">
              <label for="endDate">Imaging End Date*</label>
              <input type="date" id="endDate" name="endDate" required>
              <div id="endDate-error" class="error-message">End date must be after start date</div>
            </div>

            <div class="form-group">
              <label for="summary">Summary of Project*</label>
              <textarea id="summary" name="summary" required></textarea>
              <div id="summary-error" class="error-message">Please provide a project summary</div>
            </div>

            <div class="form-group">
              <label for="specimenDetails">Specimen Details*</label>
              <textarea id="specimenDetails" name="specimenDetails" required></textarea>
              <div id="specimenDetails-error" class="error-message">Please provide specimen details</div>
            </div>

            <div class="form-group">
              <div class="horizontal-panel2">
                <label class="label2" for="platform">Imaging Platform*</label>
              </div>
              <select multiple id="newSelectedImagingPlatforms">
                <option value="">Select Imaging Platforms</span>
                  <% imagingPlatforms.forEach(i=>{ %>
                <option value="<%=i%>">
                  <%=i%>
                </option>
                <%})%>
              </select>
            </div>

            <div class="form-group">
              <label for="comments">Comments</label>
              <textarea id="comments" name="comments"></textarea>
            </div>

            <div class="buttons">
              <button type="submit" class="new"><i class="fas fa-paper-plane"></i> Create Project</button>
            </div>

            <p class="note">
              💡 New project types, imaging platform and/or photographers will only be in the system if said changes are
              submitted
              Only one enum value of either features can be added at a single time of creation of a project.
            </p>
      </form>
  </div>
</body>

<script>
  const form = document.getElementById('main-form');
  const element = document.getElementById('newSelectedPhotographers');
  const newSelectedPhotographers = new Choices(element, {
    allowHTML: true,
    removeItemButton: true,
    callbackOnInit: async function () {
      //for admins only to select project Owner
      const projectOwnerSelect = document.getElementById('projectOwner')
      projectOwnerSelect.addEventListener('change', function (e) {
        e.preventDefault()
        const temp = (projectOwnerSelect.value).toString()
        if (temp == "") return
        previouslySelected = newSelectedPhotographers.getValue(true)
        // if (!previouslySelected.includes(temp)) {
        newSelectedPhotographers.removeActiveItems(); //clearChoices() doesn't work
        newSelectedPhotographers.setChoiceByValue(temp)
        // } else {
        //not working
        // newSelectedPhotographers.removeActiveItems(); //clearChoices() doesn't work
        // newSelectedPhotographers.setChoices(previouslySelected)
        //   const t = document.querySelectorAll('[class="choices__button"]')
        //   for (var x2 of t) {
        //     if (x2.style != "display:none;")
        //     return
        //     console.log(x2)
        //     x2.style.display = "block"
        //   }
        // }

        const x = document.querySelector("[data-value='" + temp + "']")
        x.childNodes[1].style.display = 'none'
        x.style.padding = "12px"
        x.style.backgroundColor = "gray"
        alert('selected photographers is reseted.')
      })
    }
  });
  const newSelectedImagingPlatforms = new Choices(document.getElementById('newSelectedImagingPlatforms'), {
    allowHTML: true,
    removeItemButton: true
  });
  const toBeCreatedPhotographers = []

  if ('<%=isUserRegistrationEnabled%>')
    document.getElementById('addPhotographerButton').addEventListener('click', async function (e) {
      e.preventDefault()
      Swal.fire({
        title: "Register New Photographer Account",
        text: "Register New Photographer Account",
        width: '700px',
        html: `
        <div style='height: 130px;'>
        <input 
          id="newPhotographerEmail" 
          placeholder="Enter Photographer's Email"
          style="width:95%;height:25%;font-size:30px;margin-bottom:5px" 
          required>
        <br>
        <input 
          id="newPhotographerFullName" 
          placeholder="Enter Photographer's Full Name" 
          style="width:95%;height:25%;font-size:30px;" 
          required">
          <br>
        <label style="color:red;margin-right:20px;">  Please tell your Photographer to change their account password as soon as possible.
          </label>
          <label>Passwords to these accounts will be given to you after you have created the project.<label>
          </div>
          `,
        showCancelButton: true,
      }).then((result) => {
        const email = document.getElementById('newPhotographerEmail').value

const emailRegex = /[a-z0-9!#$%&'*+\/=?^_`{|}~-]+(?:\.[a-z0-9!#$%&'*+\/=?^_`{|}~-]+)*@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?/
        console.log(emailRegex.toString())
        const fullName = document.getElementById('newPhotographerFullName').value
        if (email && fullName) {
          console.log('1')
          if (!emailRegex.test(email)) {
          console.log('2')
            alert("you entered an email with an invalid format")
            return
          }
          console.log('3')
          newSelectedPhotographers.setChoices([{
            value: email,
            label: fullName,
            selected: true
          }])
          toBeCreatedPhotographers.push([fullName, email])
        }
      });
    })

  document.addEventListener('load', function () {
    // grey out and disable this option
    //The repeated block for greying out is required for both load and DOMContentLoaded event
    if ('<%=currentUser.UserType%>' == 'admin')
      return
    const x = document.querySelector("[data-value='<%=currentUser.UserID%>']")
    x.childNodes[1].style.display = 'none'
    x.style.padding = "12px"
    x.style.backgroundColor = "gray"
  })

  document.addEventListener('DOMContentLoaded', function () {
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalBtnText = submitBtn.innerHTML;
    // grey out and disable this option
    //The repeated block for greying out is required for both load and DOMContentLoaded event
    if ('<%=currentUser.UserType%>' != 'admin') {
      const x = document.querySelector("[data-value='<%=currentUser.UserID%>']")
      x.childNodes[1].style.display = 'none'
      x.style.padding = "12px"
      x.style.backgroundColor = "gray"
    }

    newSelectedPhotographers.passedElement.element.addEventListener('removeItem', function (e) {
      toBeRemoved = [e.detail.label, e.detail.value]
      for (let x1 = 0; x1 < toBeCreatedPhotographers.length; x1++) {
        const o = toBeCreatedPhotographers[x1]
        if (o[0] == toBeRemoved[0] && o[1] == toBeRemoved[1])
          toBeCreatedPhotographers.splice(x1, 1)
      }
    }, false)
    const aDate = new Date()
    document.getElementById('startDate').value = aDate.toISOString().slice(0, 16).split('T')[0]
    aDate.setDate(aDate.getDate() + 4)
    document.getElementById('endDate').value = aDate.toISOString().slice(0, 16).split('T')[0]

    document.getElementById('startDate').addEventListener('change', function () {
      const startDate = document.getElementById('startDate').value;
      if (startDate)
        document.getElementById('endDate').min = startDate;
    });

    // Validate on submit
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const startDate = document.getElementById('startDate').value;
      const endDate = new Date(document.getElementById('endDate').value);
      const startDateError = document.getElementById('startDate-error');
      const endDateError = document.getElementById('endDate-error');
      let isValid = true;

      // Reset error messages
      document.querySelectorAll('.error-message').forEach(el => {
        el.style.display = 'none';
      });

      // Check dropdowns
      if (!form.projectOwner.value) {
        document.getElementById('projectOwnerError').style.display = 'block';
        isValid = false;
      }
      // Check text areas
      if (!form.summary.value.trim()) {
        document.getElementById('summary-error').style.display = 'block';
        isValid = false;
      }
      if (!form.specimenDetails.value.trim()) {
        document.getElementById('specimenDetails-error').style.display = 'block';
        isValid = false;
      }

      // Reset displays
      startDateError.style.display = 'none';
      endDateError.style.display = 'none';
      document.getElementById('startDate').setCustomValidity('');
      document.getElementById('endDate').setCustomValidity('');

      // Validate end date
      if (endDate < startDate) {
        endDateError.style.display = 'block';
        Swal.fire({
          icon: 'error',
          title: 'Invalid Date',
          text: 'End date must be on or after start date'
        });
        document.getElementById('endDate').setCustomValidity('End date must be after start date');
      }

      if (!form.checkValidity()) {
        isValid = false;
        form.querySelector(':invalid').scrollIntoView({
          behavior: 'smooth',
          block: 'center'
        });
      }
      if (!isValid)
        return;

      try {
        // Show loading state
        submitBtn.classList.add('loading');
        submitBtn.innerHTML = '<i class="fas fa-spinner"></i> Submitting...';
        submitBtn.disabled = true;

        const projectType = form.projectType == null ? "" : form.projectType.value
        const formData = {
          projectName: form.projectName.value,
          projectOwner: form.projectOwner.value,
          projectType: projectType,
          startDate: form.startDate.value,
          endDate: form.endDate.value,
          summary: form.summary.value,
          specimenDetails: form.specimenDetails.value,
          comments: form.comments.value || null,
          selectedImagingPlatforms: newSelectedImagingPlatforms.getValue(true),
          selectedPhotographers: newSelectedPhotographers.getValue(true),
          toBeCreatedPhotographers: toBeCreatedPhotographers
        };
        const response = await fetch('/project/create', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(formData)
        });
        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.message || "Submission failed with status " + response.status);
        }

        const data = await response.json();
        if (!data.success)
          throw new Error(data.message || "Submission failed");

        // Show success message
        await Swal.fire({
          title: 'Success!',
          text: 'project submitted successfully!',
          icon: 'success',
          confirmButtonText: 'OK',
          confirmButtonColor: '#28a745',
          timer: 1000,
          timerProgressBar: true
        });

        // Redirect if URL is provided
        if (data.redirectUrl) {
          window.location.href = data.redirectUrl;
          return; // Stop further execution
        }

        // Reset form (if no redirection)
        form.reset();

      } catch (error) {
        await Swal.fire({
          title: 'Error!',
          text: error.message,
          icon: 'error',
          confirmButtonText: 'OK',
          confirmButtonColor: '#dc3545'
        });
      } finally {
        // Reset button state
        submitBtn.classList.remove('loading');
        submitBtn.innerHTML = originalBtnText;
        submitBtn.disabled = false;
      }
    });

  });
</script>

</html>