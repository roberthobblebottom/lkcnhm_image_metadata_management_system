<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Projects</title>
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      margin: 30px;
      background: #f5f5f5;
    }

    .main_con {
      margin-left: 350px;
    }

    .btn {
      display: inline-block;
      background: #007bff;
      color: white;
      padding: 10px 16px;
      border: none;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      margin-top: 50px;
    }

    h2 {
      text-align: center;
      margin: 20px 0;
      color: #333;
    }



    .status-approved {
      color: green;
      font-weight: bold;
    }

    .status-rejected {
      color: red;
      font-weight: bold;
    }

    .view-btn,
    .edit-btn,
    .delete-btn {
      padding: 6px 12px;
      border-radius: 6px;
      text-decoration: none;
      font-size: 14px;
      color: white;
    }

    .view-btn {
      background: #17a2b8;
    }

    .view-btn:hover {
      background: #138496;
    }

    .edit-btn {
      background: #FFA500;
    }

    .edit-btn:hover {
      background: #e68a00;
    }

    .delete-btn {
      background: #dc3545;
    }

    .delete-btn:hover {
      background: #c82333;
    }

    .no-data {
      text-align: center;
      color: gray;
      margin-top: 20px;
    }
  </style>
</head>

<body>
  <div class="main_con">
    <%- currentUser.UserType=='admin' 
    ? include('../partials/sidenav-admin')
    : include('../partials/sidenav-user') %>
    <center>
      <h2 style="margin-left: 35%;margin-top: 40px;">Project Management</h2>
    </center>
    <div style="text-align: right; ">
      <a href="/project/create"><button class="btn">Add Project</button></a>
    </div>
    <% if (projects.length===0) { %>
    <p class="no-data">No projects found.</p>
    <% } else { %>
    <table id='dataTable'>
      <thead>
        <tr>
          <th>ID</th>
          <th>Project Name</th>
          <% if (currentUser.UserType=='admin' ) {%>
          <th>Project Owner</th>
          <%}%>
          <th>Project Type</th>
          <th>Photographer</th>
          <th>Start</th>
          <th>End</th>
          <th>Status</th>
          <% if(currentUser.UserType=='admin' ){%>
          <th>Delete Flag</th>
          <%}%>
          <th>Actions</th>
        </tr>
      </thead>
    <tbody>
      <% projects.forEach(request=> { %>
        <tr>
          <td><%= request.ProjectID %></td>
          <td><%=request.ProjectName %></td>
          <% if (currentUser.UserType=='admin' ) {%>
          <td><%= request.projectOwnerName  %></td>
          <%}%>
          <td><%= request.ProjectType %></td>
          <td><%= photographers[request.ProjectID] %></td>
          <td> <%= request.ImagingStartDate?.toDateString() %></td>
          <td> <%= request.ImagingEndDate?.toDateString()%></td>
          <td> <%=request.ProjectStatus %></td>
          <% if(currentUser.UserType=='admin' ){%>
          <td class="<%= !request.IsDeleted  ? 'status-approved' :  'status-rejected'  %>">
            <%= request.IsDeleted ? 'Deleted' : 'Active' %>
          </td>
          <%}%>
          <td>
          <a href="/project/view/<%= request.ProjectID %>" class="view-btn">View</a>
          <a href="/project/edit/<%= request.ProjectID %>" class="edit-btn">Edit</a>

          <% if(request.IsDeleted){%>
          <form action="/project/restore/<%= request.ProjectID %>" method="POST" onsubmit="return confirm('Are you sure you want to restore this request?');" style="display:inline;">
            <button type="submit" class="edit-btn">Restore</button>
          </form>
          <%} else {%>
          <form action="/project/delete/<%= request.ProjectID %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this request?');" style="display:inline;">
            <button type="submit" class="delete-btn">Delete</button>
          </form>
          <%}%>
          </td>
        </tr>
        <% }) %>
          </tbody>
    </table>
    <% } %>
  </div>

  <script>
    new DataTable('#dataTable')
    document.querySelectorAll('.delete-btn').forEach(button => {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        Swal.fire({
          title: 'Are you sure?',
          text: 'You will not be able to undo this action!',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#d33',
          confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
          if (result.isConfirmed) {
            this.closest('form').submit();
          }
        });
      });
    });
  </script>
</body>

</html>