<!DOCTYPE html>
<html lang="en">

<head>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/form.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@11.1.0/public/assets/styles/choices.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Project</title>
</head>

<body>
  <div class="main-con">
  <%- include(currentUser.UserType=='admin' 
  ? '../sidenavs/admin.ejs' 
  : '../sidenavs/user' ) %>

    <form id='main-form' >
    <div class="horizontal-panel">
      <a href="/project/view-all" class="btn btn-primary">
        <i class="fas fa-arrow-left"></i>
          Back to All Projects
      </a>
      <h2>Edit Project</h2>
    </div>
      <div class="form-group">
        <label>Project Name</label>
        <input type="text" id="ProjectName" name="ProjectName" value="<%= project.ProjectName %>" class="form-control" required>
      </div>

      <div class="form-group">
        <label>Project Owner</label>
        <p class="form-control-static">
          <%= project.FullName || 'Not specified' %>
        </p>
      </div>

      <div class="form-group">
        <div class="horizontal-panel2">
          <label id="label2">Project Type</label>
          <button class='addButton' id="addProjectTypeButton">Add</button>
        </div>

        <select name="projectType" id="projectType" class="form-control">
          <option value="">-- Select Project Type --</option>
          <% projectTypes.forEach(projectType=> { %>
          <option value="<%= projectType %>" <%=project.ProjectType==projectType ? 'selected' : ''%>>
            <%= projectType %>
          </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="newSelectedImagingPlatforms">Photographer(s):</label>
        <select multiple id="newSelectedPhotographers">
          <option value="">---Select Photographers---</option>
          <% allPhotographers.forEach(photographer=>{ %>
          <option value="<%=photographer.UserID%>" id="<%=photographer.UserID%>ID" <%=photographer.UserID == project.ProjectOwnerID ? "disabled": ""%> <%=selectedPhotographers.includes(photographer.UserID) ? "selected":""%>>
            <%=photographer.FullName%>
          </option>
          <%})%>
        </select>
      </div>

      <div class="form-group">
        <label for="ImagingStartDate">Imaging Start Date:</label>
        <input type="date" id="ImagingStartDate" name="ImagingStartDate" value="<%= project.ImagingStartDate %>" class="form-control" required>
      </div>

      <div class="form-group">
        <label for="ImagingEndDate">Imaging End Date:</label>
        <input type="date" id="ImagingEndDate" name="ImagingEndDate" value="<%= project.ImagingEndDate %>" class="form-control" required>
      </div>

      <div class="form-group">
        <label for="SummaryOfProject">Summary of Project:</label>
        <textarea id="SummaryOfProject" name="SummaryOfProject" class="form-control" required>
            <%= project.SummaryOfProject %>
        </textarea>
      </div>

      <div class="form-group">
        <label for="DetailsOfSpecimens">Details Of Specimens:</label>
        <textarea id="DetailsOfSpecimens" name="DetailsOfSpecimens" class="form-control" required>
            <%= project.DetailsOfSpecimens %>
        </textarea>
      </div>
      <div class="form-group">

        <div class="horizontal-panel2">
          <label  id="label2" for="imagingPlatform">Imaging Platform:</label>
          <button class='addButton' id="addImagingPlatformButton">Add</button>
        </div>
        <select multiple id="newSelectedImagingPlatforms">
          <option value="">Select Imaging Platforms</option>
          <% imagingPlatforms.forEach(i=>{ %>
          <option value="<%=i%>" <%=selectedImagingPlatforms.includes(i) ? "selected":""%>>
            <%=i%>
          </option>
          <%})%>
        </select>
      </div>

      <div class=" form-group">
        <label for="ProjectStatus">Status:</label>
        <select name="ProjectStatus" id="ProjectStatus" class="form-control" required>
          <option value="">-- Select Type --</option>
          <% statuses.forEach(status=> { %>
          <option value="<%= status %>" <%=project.ProjectStatus==status ? ' selected' : '' %>>
            <%= status%>
          </option>
          <% }) %>
        </select>
      </div>
      <div class='buttons'>
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-paper-plane"></i>
          Save Changes
        </button>
      </div>
      <p class="note">
        💡 New project types and/or imaging platform will only be in the system if said changes are submitted
      </p>
    </form>

    <br>


</div>
</body>

  <script>
    const newSelectedPhotographersElement = document.getElementById('newSelectedPhotographers');
    const newSelectedPhotographers = new Choices(newSelectedPhotographersElement, {
      allowHTML: true,
      removeItemButton: true
    });
    const newSelectedImagingPlatforms = new Choices(document.getElementById("newSelectedImagingPlatforms"), {
      allowHTML: true,
      removeItemButton: true
    });


    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('addProjectTypeButton').addEventListener('click', async function(e) {
        e.preventDefault()
        Swal.fire({
          title: "Add new Project Type",
          text: "Add new Project Type",
          input: 'text',
          showCancelButton: true,
          inputPlaceholder: "Enter it here."
        }).then((result) => {
          if (result.value && result.value != "") {
            const select = document.getElementById("projectType")
            var option = document.createElement('option')
            option.text = option.value = result.value
            select.add(option, 1)
            select.value = option.text
          }
        });
      })
      document.getElementById('addImagingPlatformButton').addEventListener('click', async function(e) {
        console.log("add Imaging Platform button")
        e.preventDefault()
        Swal.fire({
          title: "Add new Imaging Platform",
          text: "Add new Imaging Platform",
          input: 'text',
          showCancelButton: true,
          inputPlaceholder: "Enter it here."
        }).then((result) => {
          if (result.value && result.value != "") {
            console.log('adding', result.value)
            newSelectedImagingPlatforms.setChoices([{
              value: result.value,
              label: result.value,
              selected: true
            }])
          }
        });
      })


      // Removes the remove item button of the selected element that is also the project owner's id
      const x = document.querySelector("[data-value='<%=project.ProjectOwnerID%>']")
      x.removeChild(x.childNodes[1])
      x.style.padding = "12px"
      x.style.backgroundColor = "gray"
      console.log(x)
      const form = document.getElementById('main-form')
      // console.log(newSelectedPhotographersElement.childNodes)
      const requestDate = new Date('<%= project.DateofRequest %>');
      const startDateInput = document.getElementById('ImagingStartDate');
      const endDateInput = document.getElementById('ImagingEndDate');
      const currentUser = '<%= currentUser%>'
      if (currentUser.UserType === 'admin') {
        const statusSelect = document.getElementById('ProjectStatus');
        const reasonField = document.getElementById('ReasonForRequest');
      }
      // Set minimum dates
      startDateInput.min = '<%= project.DateofRequest %>';
      endDateInput.min = '<%= project.ImagingStartDate %>';

      // Real-time validation
      startDateInput.addEventListener('change', function() {
        const startDate = new Date(this.value);
        endDateInput.min = this.value;

        if (startDate < requestDate) {
          Swal.fire({
            icon: 'error',
            title: 'Invalid Date',
            text: 'Start date must be on or after request date'
          });
          this.value = '<%= project.ImagingStartDate %>';
        }
      });

      endDateInput.addEventListener('change', function() {
        const startDate = new Date(startDateInput.value);
        const endDate = new Date(this.value);

        if (endDate < startDate) {
          Swal.fire({
            icon: 'error',
            title: 'Invalid Date',
            text: 'End date must be on or after start date'
          });
          this.value = '<%= project.ImagingEndDate %>';
        }
      });
      // Form submission handler
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        // Validate dates
        console.log("here")
        const startDate = new Date(startDateInput.value);
        const endDate = new Date(endDateInput.value);
        if (startDate < requestDate) {
          Swal.fire({
            icon: 'error',
            title: 'Invalid Date',
            text: 'Start date must be on or after request date'
          });
          return;
        }

        if (endDate < startDate) {
          Swal.fire({
            icon: 'error',
            title: 'Invalid Date',
            text: 'End date must be on or after start date'
          });
          return;
        }
        if (currentUser.UserType === 'admin') {
          // Validate reason if status changed
          if (statusSelect.value !== '<%= project.RequestStatusID %>' && !reasonField.value.trim()) {
            Swal.fire({
              icon: 'error',
              title: 'Missing Reason',
              text: 'Please provide a reason for status change'
            });
            return;
          }
          // Validate that a valid status is selected
          if (statusSelect.value === '') {
            Swal.fire({
              icon: 'error',
              title: 'Invalid Status',
              text: 'Please select a valid status.'
            });
            return;
          }
        }
        // Submit form via AJAX
        try {

          const formData = new FormData(form);
          formData.append("projectOwnerID", "<%=project.ProjectOwnerID%>")
          formData.append('selectedImagingPlatforms', newSelectedImagingPlatforms.getValue(true));

          formData.append('selectedPhotographers', newSelectedPhotographers.getValue(true));
          console.log(formData)
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(Object.fromEntries(formData))
          });
          const result = await response.json();
          if (result.success) {
            Swal.fire({
              icon: 'success',
              title: 'Success!',
              text: result.message,
              timer: 1500,
              showConfirmButton: false
            }).then(() => {
              window.location.href = result.redirectUrl;
            });
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: result.message
            });
          }
        } catch (error) {
          console.error('Error:', error);
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred while updating the request'
          });
        }
      });
    });
  </script>
</html>