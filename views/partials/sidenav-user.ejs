<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/admin-users.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>

<body>
  <div class="sidebar">
    <div class="logo">
      <img src="/images/Group-1.svg" alt="LKCNHM Logo" style="width: 200px; height: auto; margin-left:10px;" />
    </div>
    <ul class="nav-links">
      <li>
<div id="fullName"></div>
        <div id="email"></div>
        <div id="userType"></div>
        <div id="userID"></div>
      </li>
      <li class="active"><a href="/user/dashboard"><i class="fas fa-chart-line"></i><span>Dashboard</span></a></li>
      <li><a href="/imagingUser"><i class="fas fa-users"></i><span>Imaging User Management</span></a></li>
      <li id="projectManagement"><a href="/project/view-all"><i class="fas fa-file-medical"></i><span>Project
            Management</span></a></li>
      <li><a href="/media/view-all"><i class="fas fa-image"></i><span>Media Management</span></a></li>
      <li><a href="/change-password"><i class="fas fa-key"></i><span>Change Password</span></a></li>

      <li><a href="/auth/logout"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a></li>
    </ul>

  </div>
  <script>

    document.addEventListener("DOMContentLoaded", function () {

      fetch("/api/current-user")
        .then(res => res.json())
        .then(data => {
          const email = data.Email;
          const fullName = data.FullName;
          const userType = data.UserType;
          const userID = data.UserID;
          document.getElementById("fullName").textContent = `Logged in as: ${fullName}`
          document.getElementById("email").textContent=`Email: ${email}`;
          document.getElementById("userType").textContent=`Role: ${userType}`;
          document.getElementById("userID").textContent=`UserID: ${userID}`;
          document.getElementById("projectManagement").hidden = UserType == 'photographerOnly' ? true : false
        })
        .catch(() => {
          document.getElementById("userGreeting").textContent = "Welcome";
        });
    });
  </script>
</body>

</html>