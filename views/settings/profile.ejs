<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/form.css">
  <title>View User</title>
  <style>
    

    #main-form {
    }
    .requirement-of-field{
    color:red;
   }
  </style>
</head>

<body>

  <%- currentUser.UserType=='admin' 
  ? include('../sidenavs/admin')
  : include('../sidenavs/user' ) %>
  <div class="main-con">
    <form id="main-form">
      <div class="form-group">
        <h2>View or Edit your Profile</h2>
        <p class="requirement-of-field">* = required</p>
      </div>


      <div class="form-group">
        <label for="userID">User ID</label>
        <input type="text" id="userID" value="<%=currentUser.UserID%>" readonly>
      </div>
      <div class="form-group">
        <label for="email">Email* </label>
        <input type="text" name="email" id="email" value="<%=currentUser.Email%>" required>
      </div>
      <div class="form-group">
        <label for="userType">User Type</label>
        <input type="text" value="<%=currentUser.UserType%>" readonly>
      </div>
      <div class="form-group">
        <label for="fullName">Full Name* </label>
        <input type="text" name="fullName" id="fullname" value="<%=currentUser.FullName%>" required>
      </div>
      <div class="form-group">
        <label>Registered Date </label>
        <input type="text" value="<%=registeredDate%>" readonly>
      </div>
      <div class="form-group">
        <label for="contactNumber">Contact Number </label>
        <input type="text" id="contactNumber" value="<%=currentUser.ContactNumber%>">
      </div>
      <div class=" form-group">
        <label for="staffType">StaffType </label>
        <select name="staffType" id="staffType">

          <option value="">-- Select a staff type--</option>
          <%staffTypes.forEach( staffType=>{%>
          <option value="<%=staffType%>"
             <%=currentUser.StaffType == staffType?'selected':''%>>
            <%=staffType%>
          </option>
          <%})%>
        </select>
      </div>
      <div class="form-group">
        <label for="comments">Comments </label>
        <textarea id="comments"><%=currentUser.Comments%></textarea>
      </div>
     

      <div class="buttons">
        <button type="submit"><i class="fas fa-paper-plane"></i> Edit Media</button>


      </div>


    </form>
  </div>

</body>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("main-form");
    form.addEventListener("submit",
      async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerHTML;
        submitBtn.classList.add('loading');
        submitBtn.innerHTML = '<i class="fas fa-spinner"></i> Submitting...';
        submitBtn.disabled = true;
        if (!/^[\w\-\.]+@([\w-]+\.)+[\w-]{2,}$/.test(form.email.value)) {

          submitBtn.disabled = false;
          submitBtn.innerHTML = 'Edit Profile';
          await Swal.fire({
            title: 'Error!',
            text: "invalid email, email value does not have '@' or '.' character(s).",
            icon: 'error',
            confirmButtonText: 'OK',
            confirmButtonColor: '#dc3545'
          });
          return
        }

        const formData = JSON.stringify({
          userID: form.userID.value,
          email: form.email.value,
          fullName: form.fullName.value,
          contactNumber: form.contactNumber.value,
          staffType: form.staffType.value,
          comments: form.comments.value,
          originalEmail: "<%=currentUser.Email%>"
        })

        const response = await fetch("/settings/profile", {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: formData
        });
        try {
          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || "Submission failed with status " + response.status);
          }

          const data = await response.json();
          if (!data.success) {
            throw new Error(data.message || "Submission failed");
          }


          // Show success message
          await Swal.fire({
            title: 'Success!',
            text: 'project submitted successfully!',
            icon: 'success',
            confirmButtonText: 'OK',
            confirmButtonColor: '#28a745',
            timer: 1000,
            timerProgressBar: true
          });

          console.log(data.redirectUrl)
          // Redirect if URL is provided
          if (data.redirectUrl) {
            window.location.href = data.redirectUrl;
            return; // Stop further execution
          }

          // Reset form (if no redirection)
          form.reset();

        } catch (error) {
          await Swal.fire({
            title: 'Error!',
            text: error.message,
            icon: 'error',
            confirmButtonText: 'OK',
            confirmButtonColor: '#dc3545'
          });
        } finally {
          submitBtn.disabled = false;
          submitBtn.value = "Edit Profile"
          submitBtn.innerHTML = 'Edit Profile';
        }
      });
  })
</script>