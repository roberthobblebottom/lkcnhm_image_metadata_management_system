<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>📸 Upload Bulk Meta Data</title>
  <link rel="stylesheet" href="/css/form.css" />
  <style>
    /* Input Fields */
    input[type="file"] {
      width: 95%;
      padding: 0.75rem 1rem;
      border: 1.5px solid #e2e8f0;
      border-radius: 8px;
      color: #1e293b;
      transition: all 0.2s ease;
      background-color: #f8fafc;
    }

    .btn {
      margin-top: 30px;
      margin-bottom: 50px;
      margin-right: 10px;
    }

    #submitButton {
      float: right;
    }

    .choices {
      width: 98% !important;

    }

    .choices__inner {
      min-height: 1px !important;
      ;
      height: 30px !important;
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@11.1.0/public/assets/styles/choices.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
</head>

<body>
  <div class="main-con">
    <%- currentUser.UserType=='admin' ? include('../sidenavs/admin') : include('../sidenavs/user') %>
      </br>
      <form id='fileUploadForm'>
        <div class="form-group">
          <h2>📸 Upload Image Metadata in Bulk</h2></br>
        </div>
        <div class="form-group">
          <label>Select Project</label>
          <select id="selectProject" required>
            <% allProjects.forEach( project=> {%>
              <option id="option<%=project.ProjectID%>" value="<%=project.ProjectID%>">
                <%=project.ProjectName%>
              </option>
              <%})%>
          </select>
        </div>

        <div class="form-group">
          <label>Select Photographer</label>
          <select id="selectPhotographer">
            <% photographers.forEach( photographer=> {%>
              <option id="option<%=photographer.PhotographerID%>" value="<%=photographer.PhotographerID%>"
                ProjectID="<%=photographer.ProjectID%>">
                <%=photographer.FullName%>
              </option>

              <%})%>
                <option value="-1">Do not override, photographers IDs are in the CSV file already</option>
          </select>
        </div>

        <div class="form-group">
          <label>Select imaging Platform</label>
          <select id="selectImagingPlatform">
            <% imagingPlatforms.forEach( imagingPlatform=> {%>
              <option id="option_<%=imagingPlatform%>" value="<%=imagingPlatform%>">
                <%=imagingPlatform%>
              </option>

              <%})%>
                <option value="-1">Do not override, imaging platforms values are in csv files already</option>
          </select>
        </div>
        <div class="form-group">
          <label>File (CSV only):</label>
          <input id="fileInput" type="file" name="bulk-metadata" accept=".csv" required />
        </div>
        <a href="/media/view-all" class="btn ">
          <i class="fas fa-arrow-left"></i> Back to all media
        </a>


        <button type="submit" class="btn" id="submitButton"><i class="fas fa-paper-plane"></i> Upload</button>

        <p class="note"> 
          You may edit metadata offline with excel before uploading or on the metadata management page after uploading
        </p>
      </form>
  </div>

  <script>
    console
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById('fileUploadForm');
      const selectProject = document.getElementById('selectProject');
      const allOptionsRaw = document.getElementById('selectPhotographer').options
      const allOptions = []
      const submitBtn = document.getElementById('submitButton');
      const originalBtnText = submitBtn.innerHTML;
      for (const o of allOptionsRaw)
        allOptions.push({
          label: o.label,
          value: o.value,
          projectID: o.attributes['2'] != null ? o.attributes['2'].value : null
        })
      const selectPhotographer = new Choices(document.getElementById('selectPhotographer'))
      let photographersToShow = []

      //INIT photographers options to show based on selected Project
      const selectedProjectID = selectProject.value
      for (x of allOptions)
        if (x.projectID == selectedProjectID)
          photographersToShow.push(x)
      photographersToShow.push({
        label: "Do not override, photographerIDs are already in the csv file.",
        value: -1,
        projectID: -1
      })
      selectPhotographer.clearChoices(clearOptions = false, clearItems = true)
      photographersToShow[0]['selected'] = true
      selectPhotographer.setChoices(photographersToShow)

      selectProject.addEventListener('change', (e) => {
        e.preventDefault()
        const selectedProjectID = selectProject.value
        photographersToShow = []
        for (x of allOptions)
          if (x.projectID == selectedProjectID)
            photographersToShow.push(x)
        photographersToShow.push({
          label: "Do not override, photographerIDs are already in the csv file.",
          value: -1,
          projectID: -1
        })
        selectPhotographer.clearChoices(clearOptions = false, clearItems = true)
        photographersToShow[0]['selected'] = true
        selectPhotographer.setChoices(photographersToShow)
      })

      form.addEventListener('submit', async (e) => {
        e.preventDefault()
        var data = null
        try {
          const formData = new FormData(form)
          formData.append("photographerID", form.selectPhotographer.value)
          formData.append("projectID", form.selectProject.value)
          formData.append("imagingPlatform", form.selectImagingPlatform.value)
          const response = await fetch('/media/upload-bulk-metadata/', {
            method: 'POST',
            // enctype: "multipart/form-data",
            body: formData
          });
          submitBtn.innerHTML = '<i class="fas fa-spinner"></i> Submitting...';
          submitBtn.disabled = true;
          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || "Submission failed with status " + response.status);
          }
          data = await response.json();

          if (!data.success) {
            var bytes = new Uint8Array(data.buffer.data);
            var blob = new Blob([bytes], { type: "application/csv" }); // change resultByte to bytes
            await Swal.fire({
              title: 'Error!',
              text: data.message,
              icon: 'error',
              confirmButtonText: 'OK',
              confirmButtonColor: '#dc3545'
            }).then(() => {
              var link = document.createElement('a');
              link.href = window.URL.createObjectURL(blob);
              link.download = "bulk metadata upload attempt error log " + new Date().toISOString() + ".csv";
              link.click();
            });
            form.reset()
            return
          }


          // Show success message
          await Swal.fire({
            title: 'Success!',
            text: 'CSV metadata upload is successfully!',
            icon: 'success',
            confirmButtonText: 'OK',
            confirmButtonColor: '#28a745',
            timer: 1000,
            timerProgressBar: true
          });
          // Redirect if URL is provided
          if (data.redirectUrl) {
            window.location.href = data.redirectUrl;
            return; // Stop further execution
          }

          // Reset form (if no redirection)
          form.reset();
        } catch (error) {
          await Swal.fire({
            title: 'Error!',
            text: error.message,
            icon: 'error',
            confirmButtonText: 'OK',
            confirmButtonColor: '#dc3545'
          });
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = "Upload"
          submitBtn.innerHTML = originalBtnText
        }
      });
    });
  </script>
</body>

</html>