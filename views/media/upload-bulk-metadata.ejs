<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>📸 Upload Bulk Meta Data</title>
  <link rel="stylesheet" href="/css/form.css" />
  <style>
    select {}

    /* Input Fields */
    input[type="file"] {
      width: 95%;
      padding: 0.75rem 1rem;
      border: 1.5px solid #e2e8f0;
      border-radius: 8px;
      color: #1e293b;
      transition: all 0.2s ease;
      background-color: #f8fafc;
    }

    .btn {
      margin-top: 30px;
      margin-bottom: 50px;
      margin-right: 10px;
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>

<body>
  <div class="main-con">
    <%- currentUser.UserType=='admin' 
        ? include('../sidenavs/admin')
        : include('../sidenavs/user') %>
    </br>
    <form id='fileUploadForm'>
      <div class="form-group">
        <h2>📸 Upload Metadata in Bulk</h2></br>
      </div>
      <div class="form-group">
        <label>Select Project</label>
        <select id="selectProjects" required>
          <% allProjects.forEach( project => {%>
          <option id="option<%=project.ProjectID%>" value="<%=project.ProjectID%>">
            <%=project.ProjectName%>
          </option>
          <%})%>
        </select>
      </div>
      <div class="form-group">
        <label>File (CSV only):</label>
        <input id="fileInput" type="file" name="bulk-metadata" accept=".csv" required />
      </div>

      <a href="/media/view-all" class="btn ">
        <i class="fas fa-arrow-left"></i> Back to all media
      </a>
      <a href="/media/download-template" class="btn ">
        <i class="fas fa-arrow-down"></i> Download Template
      </a>
      <a href="/media/download-pipeline-script" class="btn ">
        <i class="fas fa-arrow-down"></i> Download Pipeline Script
      </a>
      <input type="submit" class="btn" id="submitButton" value="Upload" />
    </form>

  </div>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById('fileUploadForm');
      form.addEventListener('submit', async (e) => {
        // const formdata = new FormData(form);
        e.preventDefault()
        const submitBtn = document.getElementById('submitButton');
        var data = null
        try {
          const formData = new FormData(form)

          const response = await fetch('/media/upload-bulk-metadata/' + form.selectProjects.value, {
            method: 'POST',
            enctype: "multipart/form-data",
            body: formData
          });
          submitBtn.innerHTML = '<i class="fas fa-spinner"></i> Submitting...';
          submitBtn.disabled = true;
          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || "Submission failed with status " + response.status);
          }
          data = await response.json();
          console.log(data)

          if (!data.success) {
            var bytes = new Uint8Array(data.buffer.data);
            var blob = new Blob([bytes], {
              type: "application/csv"
            }); // change resultByte to bytes
            await Swal.fire({
              title: 'Error!',
              text: data.message,
              icon: 'error',
              confirmButtonText: 'OK',
              confirmButtonColor: '#dc3545'
            }).then(() => {
              var link = document.createElement('a');
              link.href = window.URL.createObjectURL(blob);
              link.download = "bulk metadata upload attempt error log " + new Date().toISOString() + ".csv";
              link.click();
            });
            form.reset()
            return
          }


          // Show success message
          await Swal.fire({
            title: 'Success!',
            text: 'CSV metadata upload is successfully!',
            icon: 'success',
            confirmButtonText: 'OK',
            confirmButtonColor: '#28a745',
            timer: 1000,
            timerProgressBar: true
          });
          // Redirect if URL is provided
          if (data.redirectUrl) {
            window.location.href = data.redirectUrl;
            return; // Stop further execution
          }

          // Reset form (if no redirection)
          form.reset();
        } catch (error) {
          await Swal.fire({
            title: 'Error!',
            text: error.message,
            icon: 'error',
            confirmButtonText: 'OK',
            confirmButtonColor: '#dc3545'
          });
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = "Upload"
        }

      });
    });
  </script>


</body>

</html>