<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title></title>
  <link rel="stylesheet" href="/css/admin-users.css" />
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f9f9f9;
      margin: 40px;
    }

    h2 {
      text-align: center;
      margin-bottom: 20px;
      color: #2c3e50;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    }

    th,
    td {
      padding: 12px 16px;
      border-bottom: 1px solid #eee;
      text-align: left;
    }

    th {
      background-color: #007bff;
      color: white;
    }

    tr:hover {
      background-color: #f1f1f1;
    }

    .btn-choose {
      background-color: #28a745;
      color: white;
      padding: 8px 14px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: bold;
      transition: background-color 0.2s;
    }

    .btn-choose:hover {
      background-color: #218838;
    }

    .no-data {
      text-align: center;
      margin-top: 30px;
      font-size: 16px;
      color: #888;
    }

    .main_con {
      margin-left: 600px;

    }

    .btn-primary {
      background-color: #007bff;
      border: none;
      color: #fff;
    }

    .btn-primary:hover {
      background-color: #0056b3;
    }

    .btn-warning {
      background-color: #07daff;
      border: none;
      color: #212529;
    }

    .btn-warning:hover {
      background-color: #e0a800;
    }

    .btn {
      display: inline-block;
      background: #007bff;
      color: white;
      padding: 10px 16px;
      border: none;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      float: left;
      margin-top: 50px;
      margin-bottom: 50px;
    }
  </style>
</head>

<body>
  <div class="main_con">
    <%- currentUser.UserType=='admin' ? include('../partials/sidenav-admin'): include('../partials/sidenav-user') %>
      <a href="/media/view-all" class="btn btn-primary">
        <i class="fas fa-arrow-left"></i> Back to view all media
      </a>
      <% if(isEdit){%>
        <h2> Edit Media Metadata Entry</h2>
        <%}else{%>
          <h2> Create Media Metadata Entry</h2>
          <%}%>

            <% if (currentUser.UserType=='admin' ){%>
              <h4>📸 Firstly, Select project owner/photographer pair for Media Entry</h4>
              <%} else {%>
                <h4>📸 Firstly, Select the project that you are the photographer with for Media Entry</h4>
                <%}%>

                  <% if (users.length===0) { %>
                    <p class="no-data">No projects found.</p>
                    <% } else { %>
                      <% if (isEdit) { %>
                        <h4> Or, continue with this current project Project ID:<%=currentProject.ProjectID%>, Project
                            Name:
                            <%=currentProject.ProjectName%>, Photographer: <%=currentProject.FullName%>
                                <a href="/media/create-or-edit-for-project/<%=mediaID%>/<%=currentProject.ProjectID%>"
                                  class="btn-choose">continue</a>
                        </h4>

                        <%}%>
                          <table>
                            <thead>
                              <tr>
                                <th>Project ID</th>
                                <th>Project Name</th>
                                <th>Project Owner Full Name</th>
                                <% if (currentUser.UserType=='admin' ){%>
                                  <th>Photographer</th>
                                  <%}%>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Action</th>
                              </tr>
                            </thead>
                            <tbody>
                              <% users.forEach(row=> { if(row.ProjectID !=currentProject.ProjectID){ %>
                                <tr>
                                  <td>
                                    <%= row.ProjectID %>
                                  </td>
                                  <td>
                                    <%=row.ProjectName%>
                                  </td>
                                  <td>
                                    <%= row.projectOwnerName %>
                                  </td>

                                  <% if (currentUser.UserType=='admin' ){%>
                                    <td>
                                      <%= row.photographerName %>
                                    </td>
                                    <%}%>
                                      <td>
                                        <%= row.ImagingStartDate.toISOString().slice(0, 10) %>
                                      </td>
                                      <td>
                                        <%= row.ImagingEndDate.toISOString().slice(0, 10) %>
                                      </td>
                                      <td>
                                        <% if(isEdit){%>
                                          <a href="/media/create-or-edit-for-project/<%=mediaID%>/<%=row.ProjectID%>"
                                            class="btn-choose"> edit </a>
                                          <%} else{%>
                                            <a href="/media/create-or-edit-for-project/none/<%= row.ProjectID %>/"
                                              class="btn-choose">add
                                              one</a>
                                            <a href="/media/upload-bulk-metadata/<%= row.ProjectID %>/<%= row.PhotographerID%>"
                                              class="btn-choose">add
                                              many</a>
                                            <%}%>
                                      </td>
                                </tr>
                                <%}}) %>
                            </tbody>
                          </table>

                          <% } %>

  </div>
</body>

</html>