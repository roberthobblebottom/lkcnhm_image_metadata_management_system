<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title></title>
  <link rel="stylesheet" href="/css/admin-users.css" />
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f9f9f9;
      margin: 40px;
    }

    h2 {
      text-align: center;
      margin-bottom: 20px;
      color: #2c3e50;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    }

    th,
    td {
      padding: 12px 16px;
      border-bottom: 1px solid #eee;
      text-align: left;
    }

    th {
      background-color: #007bff;
      color: white;
    }

    tr:hover {
      background-color: #f1f1f1;
    }

    .btn-choose {
      background-color: #28a745;
      color: white;
      padding: 8px 14px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: bold;
      transition: background-color 0.2s;
    }

    .btn-choose:hover {
      background-color: #218838;
    }

    .no-data {
      text-align: center;
      margin-top: 30px;
      font-size: 16px;
      color: #888;
    }

    .main_con {
      margin-left: 600px;

    }
  </style>
</head>

<body>
  <div class="main_con">
    <%- currentUser.UserType=='admin' ? include('../partials/sidenav-admin'): include('../partials/sidenav-user') %>
      <h2>📸 Firstly, Select project owner/photographer pair for Media Entry</h2>

      <% if (users.length===0) { %>
        <p class="no-data">No projects found.</p>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Requestor Name</th>
                <th>Photographer</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(row=> { %>
                <tr>
                  <td>
                    <%= row.ProjectID %>
                  </td>
                  <td>
                    <%= row.projectOwnerName %>
                  </td>
                  <td>
                    <%= row.PhotographerName %>
                  </td>
                  <td>
                    <%= row.ImagingStartDate.toISOString().slice(0, 10) %>
                  </td>
                  <td>
                    <%= row.ImagingEndDate.toISOString().slice(0, 10) %>
                  </td>
                  <td>
                    <a href="/media/create-for-project/<%= row.ProjectID %>" class="btn-choose">add one</a>
                    <a href="/media/csv-upload-for-project/<%= row.ProjectID %>" class="btn-choose">add many</a>
                  </td>
                </tr>
                <% }) %>
            </tbody>
          </table>
          <% } %>

  </div>
</body>

</html>