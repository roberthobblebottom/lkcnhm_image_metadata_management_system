<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Media Management</title>
  <link rel="stylesheet" href="/css/table.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
  <script src="https://cdn.datatables.net/select/3.1.3/js/dataTables.select.js"></script>
  <script src="https://cdn.datatables.net/select/3.1.3/js/select.dataTables.js"></script>
  <style>
    .horizontal-panel2 {
      display: flex;
      justify-content: space-between;
      width: 250px;
    }

    .hidden {
      display: none;

    }

    .vertical-panel {
      vertical-align: middle;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .btn-restore {
      color: black;
    }

    .btn-bulk {
      height: 35px;
      display: flex;
      align-items: center;
    }
  </style>
</head>

<body>
  <div class="main-con">
    <%- currentUser.UserType=='admin' ? include('../sidenavs/admin'): include('../sidenavs/user') %>
      <div class="horizontal-panel">
        <h2>
          <%= currentUser.UserType=='admin' ? "All" : "Your" %> Image Metadata Records
        </h2>
        <% if (disableCreateMedia){ %>
          You do not have any projects you can add media to.
          <% }else{ %>
            <a href="/media/upload-bulk-metadata/" class="btn btn-bulk"><i class="fa-solid fa-file-arrow-up"></i> Upload
              <br>Bulk</a>

            <a href="/media/create/" class="btn"><i class="fa-solid fa-plus"></i> Add <br> Single Entry </a>
            <a class="btn-delete hidden" id="deletedSelected"><i class="fa-solid fa-user-plus"></i> Delete Selected</a>
            <a class="btn-restore hidden" id="restoreSelected"><i class="fa-solid fa-trash-arrow-up"></i> Restore
              Selected</a>
            <a class="btn-edit hidden" id="editSelected"><i class="fa-solid fa-pen-to-square"></i> Edit Selected</a>
            <a class="btn-restore hidden" id="deselectAll" onclick="deselectAll()"><i class="fa-regular fa-square"></i>
              Deselect All</a>


            <%}%>
              <a href="/media/download-template" class="btn-restore btn">
                <i class="fa-solid fa-file-arrow-down"></i> Download <br> Image Metadata Template
              </a>
              <a href="/media/download-pipeline-script" class="btn-restore btn">
                <i class="fa-solid fa-file-arrow-down"></i> Download <br> Extraction Tool
              </a>
      </div>
      <table id="dataTable" class="dataTable">
        <thead>
          <tr>
            <th></th>
            <th>ID</th>
            <th>Project Name</th>
            <th>Photographer</th>
            <th>Morpho ID</th>
            <th>Catalog ID</th>
            <th>Resolution</th>
            <th>Imaging Date</th>
            <th>Is Deleted?</th>
          </tr>
        </thead>
        <tbody>
        </tbody>
      </table>
      <label id="numberOfSelected"></label>
  </div>
</body>

<script>
  const pageLength = 25
  var selectedMediaIDs = []
  var selectedIndexes = []
  var justRendered = false
  const dt = new DataTable('#dataTable', {
    select: {
      style: 'multi',
      //  selector: 'td:first-child'
    },
    columnDefs: [
      {
        orderable: true,
        render: (data, type, full) => {
          if (selectedMediaIDs.includes(full.MediaID))
            return '<label id="checkbox_' + full.MediaID + '" style="font-size:20px">☑</label>'
          else
            return '<label id="checkbox_' + full.MediaID + '" style="font-size:20px">☐</label>'
        },
        orderData: [], targets: 0
      },
      { orderable: false, targets: 9 }
    ],
    columns: [
      { data: "s", name: "s" },
      { data: 'MediaID', name: 'MediaID' },
      { data: 'ProjectName', name: "ProjectName" },
      { data: 'photographerName', name: "photographerName" },
      { data: 'MorphoID', name: "MorphoID" },
      { data: 'CatalogID', name: "CatalogID" },
      {
        data: 'Resolution', name: "Resolution", mRender: (data, type, full) =>
          full.Resolution ? full.Resolution : "Not Specified"
      },
      {
        data: 'ImagingDate', name: "ImagingDate", mRender: (data, type, full) =>
          full.ImagingDate ? full.ImagingDate.split("T")[0] : "Not Specified"
      },
      {
        data: 'IsDeleted', name: "IsDeleted", mRender: (data, type, full) =>
          full.IsDeleted
            ? `<label class='status-rejected'>Yes</label> `
            : `<label class='status-approved' >No</label>`
      },
      {
        data: 'Actions', title: 'Actions', mRender: (data, type, full) => {
          var html = `
        <div class="horizontal-panel2">
            <a href="/media/view/${full.MediaID}" class="btn-view"
            onsubmit="deselectAll()"
            >
           <i class="fa-solid fa-magnifying-glass"></i> 
            View</a>`
          return full.IsDeleted
            ? html + `
          <a href="/media/edit/${full.MediaID}" class='disabled' ><i class="fa-solid fa-pen-to-square"></i> Edit</a>
              <form action="/media/restore/${full.MediaID}" method="POST"
                onsubmit="return confirm('Are you sure you want to restore this image metadata?');">
                <button type="submit" class="btn-restore"><i class="fa-solid fa-trash-arrow-up"></i> Restore</button>
              </form>
          </td>`
            : html + `
          <a href="/media/edit/${full.MediaID}" class='btn-edit' ><i class="fa-solid fa-pen-to-square"></i> Edit</a>
              <form action="/media/delete/${full.MediaID}" method="POST"
                onsubmit="dt.rows().deselect(); return confirm('Are you sure you want to delete this image metadata?');">
                <button type="submit" class="btn-delete"><i class="fa-solid fa-trash"></i> Delete</button>
              </form>
          </div>`
        }
      }],
    deferloading: 10,
    pageLength: pageLength,
    processing: true,
    autoWidth: false,
    serverSide: true,
    ajax: {
      url: "/media/view-all-processing/",
      type: "POST"
    },

  })


  function deselectAll() {
    //for the buttons in each row. do not remove
    dt.rows().deselect();
    dt.rows().invalidate().draw()
    selectedMediaIDs = []
    showButtonsIfAnySelectedMediaIDs()
  }
  function showButtonsIfAnySelectedMediaIDs() {
    if (selectedMediaIDs.length == 0) {
      document.getElementById("deletedSelected").style.display = 'none '
      document.getElementById("restoreSelected").style.display = 'none'
      document.getElementById("editSelected").style.display = 'none'
      document.getElementById("deselectAll").style.display = 'none'
    } else {
      document.getElementById("deletedSelected").style.display = 'inline '
      document.getElementById("restoreSelected").style.display = 'inline'
      document.getElementById("editSelected").style.display = 'inline'
      document.getElementById("deselectAll").style.display = 'inline'
    }

  }
  dt.on('draw', (e, settings) => {
    for (id of selectedMediaIDs) {
      const index = dt.column(1).data().indexOf(id)
      if (index > -1) {
        justRendered = true
        dt.row(index).select()
        // const c = dt.row(index).data()
        // c['s'] = '☑'
      }
      // data.select()
    }
    showButtonsIfAnySelectedMediaIDs()
  }
  )

  document.addEventListener("DOMContentLoaded", (e) => {
    dt.on('select', (e, dt, type, indexes) => {
      if (justRendered) {
        justRendered = false
        return
      }
      const n = dt.column(1).data()[parseInt(indexes[indexes.length - 1])]
      selectedMediaIDs.push(n)
      document.getElementById('numberOfSelected').textContent = "Selected Media IDs:" + selectedMediaIDs

      const c = dt.row(n).data()
      document.getElementById("checkbox_" + n.toString()).textContent = '☑'

      showButtonsIfAnySelectedMediaIDs()
    })

    dt.on('deselect', (e, dt, type, indexes) => {
      const n = dt.column(1).data()[parseInt(indexes[indexes.length - 1])]
      selectedMediaIDs.pop(n)
      document.getElementById('numberOfSelected').textContent = ""
      const c = dt.row(n).data()
      document.getElementById("checkbox_" + n.toString()).textContent = '☐'

      showButtonsIfAnySelectedMediaIDs()
    })
  })
  document.getElementById('deletedSelected').addEventListener('click', async (e) => {
    await Swal.fire({
      title: 'Confirmation',
      text: 'Are you sure you want to delete the selected rows? Selected IDs:' + selectedMediaIDs + '.Rows that are already deleted will be ignored',
      confirmButtonText: 'OK',
      confirmButtonColor: '#28a745'
    }).then(async (result) => {
      if (!result['isConfirmed'])
        return
      const response = await fetch('/media/bulk-delete', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(selectedMediaIDs)
      })
      try {
        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.message || "Submission failed with status " + response.status);
        }

        const data = await response.json();
        if (!data.success)
          throw new Error(data.message || "Submission failed");


        await Swal.fire({
          title: 'Success!',
          text: 'metadata deleted successfully!',
          icon: 'success',
          confirmButtonText: 'OK',
          confirmButtonColor: '#28a745',
          timer: 1000,
          timerProgressBar: true
        });

        window.location.href = '/media/view-all';
        return;
      } catch (error) {
        await Swal.fire({
          title: 'Error!',
          text: error.message,
          icon: 'error',
          confirmButtonText: 'OK',
          confirmButtonColor: '#dc3545'
        });
      }
    });
  })
  document.getElementById('restoreSelected').addEventListener('click', async (e) => {
    await Swal.fire({
      title: 'Confirmation',
      text: 'Are you sure you want to restore the selected rows? Selected IDs:' + selectedMediaIDs + '.Rows that are already restored will be ignored',
      confirmButtonText: 'OK',
      confirmButtonColor: '#28a745'
    }).then(async (result) => {
      if (!result['isConfirmed'])
        return
      const response = await fetch('/media/bulk-restore', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(selectedMediaIDs)
      })
      try {
        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.message || "Submission failed with status " + response.status);
        }

        const data = await response.json();
        if (!data.success) {
          throw new Error(data.message || "Submission failed");
        }

        await Swal.fire({
          title: 'Success!',
          text: 'metadata restored successfully!',
          icon: 'success',
          confirmButtonText: 'OK',
          confirmButtonColor: '#28a745',
          timer: 1000,
          timerProgressBar: true
        });

        window.location.href = '/media/view-all';
        return;
      } catch (error) {
        await Swal.fire({
          title: 'Error!',
          text: error.message,
          icon: 'error',
          confirmButtonText: 'OK',
          confirmButtonColor: '#dc3545'
        });
      }
    });
  })
  document.getElementById('editSelected').addEventListener('click', async (e) => {
    const editSelected = document.getElementById('editSelected')
    editSelected.href = '/media/bulk-edit/?array='
      + JSON.stringify(selectedMediaIDs)
    editSelected.click()
  })
</script>

</html>