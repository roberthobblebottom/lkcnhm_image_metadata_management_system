<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Media Management</title>
  <link rel="stylesheet" href="/css/table.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
  <style>
    .horizontal-panel2 {
      display: flex;
      justify-content: space-between;
      width: 250px;
    }

/* 
    .fileName {
      max-width: 400px;
      text-overflow: ellipsis;
      overflow: hidden;
      white-space: nowrap;
    } */
  </style>
</head>

<body>
  <div class="main-con">
    <%- currentUser.UserType=='admin' ? include('../sidenavs/admin'): include('../sidenavs/user') %>
    <div class="horizontal-panel">
      <h2><%= currentUser.UserType=='admin'? "All": "Your"%> Image Metadata Records</h2>
      <% if (disableCreateMedia){ %>
      You do not have any projects you can add media to.
      <% }else{ %>
      <a href="/media/create/" class="btn">Add Media(s)</a>
      <a href="/media/upload-bulk-metadata/" class="btn"> Upload Bulk MetaData</a>
      <%}%>
    </div>

    <% if (medias.length===0) { %>
      <p class="no-data">No media records found.</p>
      <% } else { %>
      <table id="dataTable" class="dataTable">
        <thead>
          <tr>
            <th>Media ID</th>
            <th>Project ID</th>
            <th>Project Name</th>
            <th>Photographer</th>
            <th class="fileName">Morpho ID</th>
            <!-- <th id="forthColumn">File Path</th> -->
            <th>Catalog ID</th>
            <th>Resolution</th>
            <th>Imaging Date</th>
            <%if (currentUser.UserType=='admin' ){%>
            <th>Is Deleted?</th>
            <%}%>
          <th >Actions</th>
        </tr>
      </thead>
    <tbody>
      <% medias.forEach(media=> { %>
          <tr>
            <td> <%= media.MediaID %></td>
            <td> <%= media.ProjectID || 'Not Specified'%></td>
            <td> <%= media.ProjectName || 'Not Specified'%></td>
            <td> <%= media.photographerName || 'Not Specified'%></td>
            <td class="fileName"><%= media.MorphoID%></td>
            <!-- <td><%= media.FilePath %></td> -->
            <td> <%= media.CatalogID  %></td>
            <td><%= media.Resolution || 'Not Specified'%></td>
            <td> <%= media.ImagingDate?.toISOString().slice(0, 10) || 'Not Specified' %></td>

            <%if (currentUser.UserType=='admin' ){%>
            <td class="<%= !media.IsDeleted  ? 'status-approved' :  'status-rejected'  %>">
              <%=!media.IsDeleted? 'No' : 'Yes' %>
            </td>
            <%}%>
            <td class="horizontal-panel2">
              <a href="/media/view/<%= media.MediaID %>"class="btn-view">View</a>
            <a href="/media/edit/<%=media.MediaID%>" class="<%=media.IsDeleted?'disabled':'btn-edit'%>">
              Edit</a>

            <%if (!media.IsDeleted ){%>
            <form action="/media/delete/<%= media.MediaID %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this image metadata record ?');">
              <button type="submit" class="btn-delete">Delete</button>
            </form>
            <%} else {%>
            <form action="/media/restore/<%= media.MediaID %>" method="POST" onsubmit="return confirm('Are you sure you want to restore this image metadata record ?');">
              <button type="submit" class="btn-restore">restore</button>
            </form>
            <%}%>
          </td>
        </tr>
      <%})%>
            </tbody>
      </table>
      <%}%>
  </div>
</body>

<script>
  new DataTable('#dataTable',{pageLength:50, autoWidth: false, columnDefs:[{width:'100%',targets:"_all"}]})


</script>

</html>