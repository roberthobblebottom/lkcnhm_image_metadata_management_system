<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Media Management</title>
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      margin: 30px;
      background: #f5f5f5;
    }

    .main_con {
      margin-left: 300px;
    }

    .btn {
      display: inline-block;
      background: #007bff;
      color: white;
      padding: 10px 16px;
      border: none;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
           margin-top: 50px;
      margin-bottom: 50px;
      margin-left: 10px;
    }

    h2 {
      text-align: center;
      margin: 20px 0;
      color: #333;
    }

    table {

      width: 100%;
      border-collapse: collapse;
      background: white;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      border-radius: 8px;
      overflow: hidden;
      margin-top: 30px;
    }

    th,
    td {
      padding: 12px 15px;
      border-bottom: 1px solid #eee;
      text-align: left;
    }

    th {
      background-color: #007bff;
      color: white;
      font-weight: 600;
    }

    tr:hover {
      background-color: #f1f1f1;
    }

    .action-btns button {
      margin-right: 6px;
      padding: 5px 10px;
      font-size: 14px;
      border-radius: 4px;
      cursor: pointer;
    }

    .btn-view {
      background-color: #17a2b8;
      color: #fff;
    }

    .btn-edit {
      background-color: #ffc107;
      color: #000;
    }

    .btn-delete {
      background-color: #dc3545;
      color: #fff;
    }

    .no-data {
      text-align: center;
      color: gray;
      margin-top: 20px;
    }

    .status-approved {
      color: green;
      font-weight: bold;
    }

    .status-rejected {
      color: red;
      font-weight: bold;
    }

    .btn-restore {
      background: #54d300;
    }
  </style>
</head>

<body>
  <div class="main_con">
    <%- currentUser.UserType=='admin' ? include('../sidenavs/admin'): include('../sidenavs/user') %>
    <%if (currentUser.UserType=='admin' ){%>
    <h2>All Photography Metadata Records</h2>
    <%} else {%>
    <h2>Your Photography Metadata Records</h2>
    <%}%>

    <% if (disableCreateMedia){ %>
    You do not have any projects you can add media to.
    <% }else{ %>
    <a href="/media/create/" class="btn">Add Media(s)</a>
    <a href="/media/upload-bulk-metadata/" class="btn"> Upload Bulk MetaData</a>
    <%}%>
    
            
    <% if (medias.length===0) { %>
    <p class="no-data">No media records found.</p>
    <% } else { %>
    <table id="dataTable">
      <thead>
        <tr>
          <th>Media ID</th>
          <th>Project ID</th>
          <th>Project Name</th>
          <%if (currentUser.UserType=='admin' ){%>
          <th>Photographer</th>
          <%}%>
          <th>File Name</th>
          <th>Catalog ID</th>
          <th>Imaging Date</th>
          <%if (currentUser.UserType=='admin' ){%>
          <th>Is Deleted?</th>
          <%}%>
          <th>Actions</th>
        </tr>
      </thead>
    <tbody>
      <% medias.forEach(media=> { %>
        <tr>
          <td> <%= media.MediaID %></td>
          <td> <%= media.ProjectID %></td>
          <td> <%= media.ProjectName %></td>
          <%if (currentUser.UserType=='admin' ){%>
          <td> <%= media.photographerName%></td>
          <%}%>
            <td><%= media.FileName %></td>
          <td> <%= media.CatalogID  %></td>
          <td> <%= media.ImagingDate?.toISOString().slice(0, 10) %></td>
          <td class="<%= !media.IsDeleted  ? 'status-approved' :  'status-rejected'  %>">
            <%=!media.IsDeleted? 'No' : 'Yes' %>
          </td>
          <td class="action-btns">
            <a href="/media/view/<%= media.MediaID %>"><button class="btn-view">View</button></a>
          <a href="/media/edit/<%=media.MediaID%>"><button class="btn-edit">Edit</button></a>

          <%if (!media.IsDeleted ){%>
          <form action="/media/delete/<%= media.MediaID %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this media ?');">
            <button type="submit" class="btn-delete">Delete</button>
          </form>
          <%} else {%>
          <form action="/media/restore/<%= media.MediaID %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to restore this media ?');">
            <button type="submit" class="btn-restore">restore</button>
          </form>
          <%}%>
          </td>
        </tr>
      <%})%>
          </tbody>
    </table>
    <%}%>
  </div>
</body>

<script>
  new DataTable('#dataTable')
</script>

</html>